---
import Logo from "./Logo.astro";
import { site as siteKo, nav as navKo } from "../data/site";
import { site as siteEn, nav as navEn } from "../data/site.en";
import { langOf, localePath, ui } from "../i18n";

const lang = langOf(Astro.url);
const t = ui[lang];
const site = lang === "en" ? siteEn : siteKo;
const nav = lang === "en" ? navEn : navKo;
---
<footer class="border-t border-line bg-surface">
  <div class="wrap grid gap-10 py-12 md:grid-cols-[1.3fr_1fr]">
    <div>
      <Logo class="block h-[28px] w-auto text-ink" />
      <div class="mt-4 mb-3 h-px bg-ink opacity-85"></div>
      <p class="m-0 font-display text-[14.5px] font-bold tracking-[-.015em]">{site.tagline}</p>
      {lang === "ko" && <p class="mt-1 font-mono text-[11.5px] text-ink-3">{site.english}</p>}
    </div>
    <nav aria-label={t.footerMenu}>
      <ul class="grid grid-cols-2 gap-x-6 gap-y-1.5 text-[14px]">
        {[...nav, { href: localePath("/contact", lang), label: t.contact }].map((item) => (
          <li><a href={item.href} class="text-ink-2 no-underline hover:text-accent-ink">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-wrap justify-between gap-x-6 gap-y-2 py-6 text-[12.5px] leading-relaxed text-ink-3">
      <address class="not-italic">
        {site.name} · {t.ceo} {site.ceo}{site.bizRegNo && ` · ${t.bizRegNo} ${site.bizRegNo}`}<br>
        {site.address} ({site.postcode})<br>
        <a href={site.phoneHref} class="text-ink-3 no-underline hover:text-accent-ink">{site.phone}</a>{" · "}
        <a href={`mailto:${site.email}`} class="text-ink-3 no-underline hover:text-accent-ink">{site.email}</a>
      </address>
      <span class="self-end">&copy; {new Date().getFullYear()} {site.name}</span>
    </div>
  </div>
</footer>
