---
import Logo from "./Logo.astro";
import { nav } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "");
---
<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/85">
  <div class="wrap flex h-[64px] items-center gap-6">
    <a href="/" class="flex-none" aria-label="Nexus Solution 홈">
      <Logo class="block h-[26px] w-auto text-ink sm:h-[30px]" />
    </a>

    <nav class="ml-auto hidden lg:block" aria-label="주 메뉴">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class="block px-3 py-2 font-display text-[14.5px] font-bold tracking-[-.01em] text-ink-2 no-underline hover:text-red-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-red aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[10px]"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contact" class="btn btn-primary ml-auto hidden !px-4 !py-2 !text-[14px] sm:inline-flex lg:ml-2">상담 문의</a>

    <button type="button" data-theme-toggle
            class="grid h-[38px] w-[38px] flex-none cursor-pointer place-items-center border border-line bg-surface text-ink-2 hover:border-red hover:text-red-ink max-sm:ml-auto"
            aria-label="어두운 화면으로 전환" title="어두운 화면으로 전환">
      <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
    </button>

    <details class="group relative lg:hidden" data-menu>
      <summary class="grid h-[38px] w-[38px] cursor-pointer list-none place-items-center border border-line bg-surface text-ink [&::-webkit-details-marker]:hidden" aria-label="메뉴 열기">
        <svg class="h-[18px] w-[18px] group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="hidden h-[18px] w-[18px] group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <nav class="fixed inset-x-0 top-[64px] border-b border-line bg-surface shadow-[0_12px_24px_-16px_rgba(0,0,0,.25)]" aria-label="모바일 메뉴">
        <ul class="wrap py-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}
                 class="flex items-center border-b border-line py-3.5 font-display text-[16px] font-bold text-ink no-underline last:border-0 aria-[current=page]:text-red-ink">{item.label}</a>
            </li>
          ))}
          <li class="pt-4 pb-2"><a href="/contact" class="btn btn-primary w-full">상담 문의</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    if (!btn) return;
    const t = root.dataset.theme === "dark" ? "밝은 화면으로 전환" : "어두운 화면으로 전환";
    btn.setAttribute("aria-label", t);
    btn.title = t;
  };
  label();
  btn?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
    label();
  });

  // 메뉴 밖을 누르거나 Esc를 누르면 모바일 메뉴를 닫습니다
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
  document.addEventListener("click", (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
  });
</script>
