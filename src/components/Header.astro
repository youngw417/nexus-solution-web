---
import Logo from "./Logo.astro";
import { nav as navKo } from "../data/site";
import { nav as navEn } from "../data/site.en";
import { langOf, localePath, ui } from "../i18n";

const lang = langOf(Astro.url);
const t = ui[lang];
const nav = lang === "en" ? navEn : navKo;
const path = Astro.url.pathname.replace(/\/$/, "");
const home = localePath("/", lang);
const contact = localePath("/contact", lang);
// 같은 페이지의 다른 언어 주소
const langs = [
  { code: "ko", label: "KO", name: "한국어", href: localePath(path || "/", "ko") },
  { code: "en", label: "EN", name: "English", href: localePath(path || "/", "en") },
];
---
<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/85">
  <div class="wrap flex h-[64px] items-center gap-3 sm:gap-6">
    <a href={home} class="flex-none" aria-label={t.home}>
      <Logo class="block h-[26px] w-auto text-ink sm:h-[30px]" />
    </a>

    <nav class="ml-auto hidden lg:block" aria-label={t.mainMenu}>
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? "page" : undefined}
              class="block px-3 py-2 font-display text-[14.5px] font-bold tracking-[-.01em] text-ink-2 no-underline hover:text-accent-ink aria-[current=page]:text-ink aria-[current=page]:underline aria-[current=page]:decoration-accent aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-[10px]"
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={contact} class="btn btn-primary ml-auto hidden !px-4 !py-2 !text-[14px] sm:inline-flex lg:ml-2">{t.contact}</a>

    <!-- 언어 선택 — 같은 페이지의 다른 언어로 이동합니다 -->
    <div class="flex h-[38px] flex-none items-center border border-line bg-surface font-mono text-[12px] max-sm:ml-auto" role="group" aria-label={t.langSwitch}>
      {langs.map((l) => (
        <a href={l.href} lang={l.code} hreflang={l.code} title={l.name} aria-current={l.code === lang ? "true" : undefined}
           class="grid h-full place-items-center px-2.5 text-ink-3 no-underline hover:text-accent-ink aria-[current=true]:bg-btn aria-[current=true]:text-btn-ink">{l.label}</a>
      ))}
    </div>

    <button type="button" data-theme-toggle
            data-to-dark={t.toDark} data-to-light={t.toLight}
            class="grid h-[38px] w-[38px] flex-none cursor-pointer place-items-center border border-line bg-surface text-ink-2 hover:border-accent hover:text-accent-ink"
            aria-label={t.toDark} title={t.toDark}>
      <svg class="h-[18px] w-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      <svg class="hidden h-[18px] w-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M2 12h2M20 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"/></svg>
    </button>

    <details class="group relative lg:hidden" data-menu>
      <summary class="grid h-[38px] w-[38px] cursor-pointer list-none place-items-center border border-line bg-surface text-ink [&::-webkit-details-marker]:hidden" aria-label={t.openMenu}>
        <svg class="h-[18px] w-[18px] group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="hidden h-[18px] w-[18px] group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </summary>
      <nav class="fixed inset-x-0 top-[64px] border-b border-line bg-surface shadow-[0_12px_24px_-16px_rgba(0,0,0,.25)]" aria-label={t.mobileMenu}>
        <ul class="wrap py-3">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}
                 class="flex items-center border-b border-line py-3.5 font-display text-[16px] font-bold text-ink no-underline last:border-0 aria-[current=page]:text-accent-ink">{item.label}</a>
            </li>
          ))}
          <li class="pt-4 pb-2"><a href={contact} class="btn btn-primary w-full">{t.contact}</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const label = () => {
    if (!btn) return;
    const t = (root.dataset.theme === "dark" ? btn.dataset.toLight : btn.dataset.toDark) ?? "";
    btn.setAttribute("aria-label", t);
    btn.title = t;
  };
  label();
  btn?.addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
    label();
  });

  // 메뉴 밖을 누르거나 Esc를 누르면 모바일 메뉴를 닫습니다
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
  document.addEventListener("click", (e) => {
    if (menu?.open && !menu.contains(e.target as Node)) menu.open = false;
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu?.open) { menu.open = false; menu.querySelector("summary")?.focus(); }
  });
</script>
