---
import { langOf, localePath, ui } from "../i18n";

interface Props {
  title?: string;
  body?: string;
}
const lang = langOf(Astro.url);
const t = ui[lang];
const { title = t.cta.title, body = t.cta.body } = Astro.props;
---
<section class="on-dark border-t border-line bg-band text-[#F0F0F0]">
  <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-[60ch]">
      <p class="eyebrow !text-accent"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>{t.cta.eyebrow}</p>
      <h2 class="h2 mb-2 !text-[#F0F0F0]">{title}</h2>
      <p class="m-0 text-[15.5px] opacity-75">{body}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={localePath("/diagnosis", lang)} class="btn btn-primary">{t.cta.start}</a>
      <a href={localePath("/contact", lang)} class="btn border-white/40 text-[#F0F0F0] hover:border-accent hover:text-accent">{t.contact}</a>
    </div>
  </div>
</section>
