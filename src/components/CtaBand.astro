---
interface Props {
  title?: string;
  body?: string;
}
const {
  title = "어디서부터 시스템으로 바꿀지, 3분이면 보입니다",
  body = "12개 문항에 답하면 시스템화 효과와 데이터 준비도를 바로 확인할 수 있습니다. 이메일 없이 시작합니다.",
} = Astro.props;
---
<section class="border-t border-line bg-ink text-ground">
  <div class="wrap flex flex-col gap-6 py-14 md:flex-row md:items-center md:justify-between">
    <div class="max-w-[60ch]">
      <p class="eyebrow !text-red"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>무료 시스템화 진단</p>
      <h2 class="h2 mb-2 !text-ground">{title}</h2>
      <p class="m-0 text-[15.5px] opacity-75">{body}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href="/diagnosis" class="btn btn-primary">진단 시작하기</a>
      <a href="/contact" class="btn border-ground/40 text-ground hover:border-red hover:text-red">상담 문의</a>
    </div>
  </div>
</section>
