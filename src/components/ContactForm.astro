---
import { site as siteKo } from "../data/site";
import { site as siteEn } from "../data/site.en";
import { services as servicesKo } from "../data/content";
import { services as servicesEn } from "../data/content.en";
import { langOf, ui } from "../i18n";

const lang = langOf(Astro.url);
const f = ui[lang].form;
const site = lang === "en" ? siteEn : siteKo;
const services = lang === "en" ? servicesEn : servicesKo;

interface Props {
  // 어떤 경로로 들어온 문의인지 구분합니다 (예: "contact", "brochure")
  kind?: string;
  submitLabel?: string;
  messageLabel?: string;
  messagePlaceholder?: string;
}
const {
  kind = "contact",
  submitLabel = f.submit,
  messageLabel = f.messageLabel,
  messagePlaceholder = f.messagePlaceholder,
} = Astro.props;
---
<form class="border border-line bg-surface p-6 sm:p-8" data-lead-form data-kind={kind} data-lang={lang} novalidate>
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="field">
      <label for={`${kind}-company`}>{f.company} <span class="text-accent-ink">*</span></label>
      <input class="input" id={`${kind}-company`} name="company" required autocomplete="organization">
    </div>
    <div class="field">
      <label for={`${kind}-name`}>{f.name} <span class="text-accent-ink">*</span></label>
      <input class="input" id={`${kind}-name`} name="name" required autocomplete="name" placeholder={f.namePlaceholder}>
    </div>
    <div class="field">
      <label for={`${kind}-email`}>{f.email} <span class="text-accent-ink">*</span></label>
      <input class="input" id={`${kind}-email`} name="email" type="email" required autocomplete="email">
    </div>
    <div class="field">
      <label for={`${kind}-phone`}>{f.phone}</label>
      <input class="input" id={`${kind}-phone`} name="phone" type="tel" autocomplete="tel" placeholder={f.phonePlaceholder}>
    </div>
    {kind === "contact" && (
      <div class="field sm:col-span-2">
        <label for={`${kind}-interest`}>{f.interest}</label>
        <select class="input" id={`${kind}-interest`} name="interest">
          <option value="">{f.interestNone}</option>
          {services.map((s) => <option value={s.name}>{s.name}</option>)}
        </select>
      </div>
    )}
    <div class="field sm:col-span-2">
      <label for={`${kind}-message`}>{messageLabel}</label>
      <textarea class="input min-h-[120px] resize-y" id={`${kind}-message`} name="message" placeholder={messagePlaceholder}></textarea>
    </div>
    <!-- 스팸 방지용 숨김 필드 -->
    <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>
    <label class="flex items-start gap-2.5 text-[13.5px] text-ink-2 sm:col-span-2">
      <input type="checkbox" name="consent" required class="mt-1 h-4 w-4 flex-none accent-[var(--accent)]">
      <span>{f.consent}</span>
    </label>
  </div>
  <div class="mt-6 flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary cursor-pointer disabled:cursor-wait disabled:opacity-60">{submitLabel}</button>
    <p class="m-0 text-[13px] text-ink-3" data-status role="status" aria-live="polite"></p>
  </div>
</form>

<script define:vars={{ email: site.email, phone: site.phone, f }}>
  document.querySelectorAll("[data-lead-form]").forEach(function (form) {
    var status = form.querySelector("[data-status]");
    var btn = form.querySelector("button[type=submit]");

    form.addEventListener("submit", async function (e) {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      var data = Object.fromEntries(new FormData(form));
      data.kind = form.dataset.kind;
      data.page = location.pathname;
      data.lang = form.dataset.lang;
      btn.disabled = true;
      status.textContent = f.sending;
      try {
        var res = await fetch("/api/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        var done = document.createElement("div");
        done.innerHTML = '<p class="h3 mb-2"></p><p class="m-0 text-ink-2"></p>';
        done.firstChild.textContent = f.doneTitle;
        done.lastChild.textContent = f.doneBody.replace("{email}", data.email).replace("{phone}", phone);
        form.replaceChildren(done);
      } catch (err) {
        // 서버 접수가 안 되면 메일 앱으로 넘겨 문의가 사라지지 않게 합니다
        var body = [f.mailCompany + ": " + data.company, f.mailName + ": " + data.name, f.mailEmail + ": " + data.email, f.mailPhone + ": " + (data.phone || ""), data.interest ? f.mailInterest + ": " + data.interest : "", "", data.message || ""].join("\n");
        var href = "mailto:" + email + "?subject=" + encodeURIComponent(f.mailSubject + " " + data.company) + "&body=" + encodeURIComponent(body);
        status.textContent = f.failed + " ";
        var link = document.createElement("a");
        link.href = href;
        link.className = "text-accent-ink";
        link.textContent = f.byMail;
        status.append(link, " " + f.orCall.replace("{phone}", phone));
        btn.disabled = false;
      }
    });
  });
</script>
