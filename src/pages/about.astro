---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
import { capabilities, principles } from "../data/content";
---
<Base title="회사 소개" description="Nexus Solution은 회사의 흩어진 데이터를 정리하고, 그 회사에 꼭 맞는 소프트웨어를 만들어 운영까지 맡는 판교 기반 회사입니다.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="회사 소개" title="회사에 맞는 소프트웨어를<br>한 팀이 끝까지">
        {site.name}은 회사가 패키지 소프트웨어에 맞추는 대신, <strong>소프트웨어가 회사에 맞도록</strong> 만듭니다.
        흩어진 데이터를 정리하고, 업무 흐름에 맞춘 시스템을 직접 개발하고, 만든 뒤에도 운영과 개선을 맡습니다.
      </SectionHead>
    </div>
  </section>

  <section class="border-b border-line">
    <img src="/photos/about-work.jpg" width="2000" height="857" class="block aspect-[21/9] max-h-[460px] w-full object-cover object-[center_20%]"
         alt="안전모와 조끼를 입은 두 사람이 태블릿과 노트북을 들고 공장 현장을 살펴보는 모습" />
  </section>

  <section class="border-b border-line py-16">
    <div class="wrap">
      <SectionHead label="세 가지 역량" title="만드는 것만으로는 업무가 바뀌지 않습니다" />
      <img src="/illustrations/process-diagram.svg" width="1000" height="340" loading="lazy" class="mt-8 block h-auto w-full border border-line"
           alt="데이터 정리에서 맞춤 개발, 운영과 개선으로 이어지고, 운영하며 다시 개발로 돌아가 계속 개선하는 흐름" />
      <div class="grid-rule mt-8 md:grid-cols-3">
        {capabilities.map(({ name: k, en, body }) => (
          <div class="p-6">
            <span class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{en}</span>
            <h3 class="h3 mt-1 mb-2 !text-[20px]">{k}</h3>
            <p class="m-0 text-[14.5px] text-ink-2">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-surface py-16">
    <div class="wrap grid gap-10 md:grid-cols-2">
      <SectionHead label="원칙" title="이렇게 일합니다" />
      <ol class="m-0 grid list-none gap-6 p-0">
        {principles.map(({ title: t, body: b }, i) => (
          <li class="grid grid-cols-[2.5em_1fr] gap-3">
            <span class="font-mono text-[13px] text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
            <span><b class="mb-1 block font-display text-[16.5px]">{t}</b><span class="text-[14.5px] text-ink-2">{b}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16">
    <div class="wrap">
      <SectionHead label="회사 정보" title="Nexus Solution" />
      <dl class="grid-rule mt-6 sm:grid-cols-2">
        {[
          ["상호", site.name],
          ["대표", site.ceo],
          ["주소", `${site.address} (${site.postcode})`],
          ["연락처", `${site.phone} · ${site.email}`],
          ...(site.bizRegNo ? [["사업자등록번호", site.bizRegNo]] : []),
        ].map(([k, v]) => (
          <div class="p-5"><dt class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{k}</dt><dd class="m-0 text-ink">{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand />
</Base>
