---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import Diagnosis from "../components/Diagnosis.tsx";
---
<Base title="시스템화 진단" description="12개 문항, 3분. 우리 회사 업무를 시스템으로 바꿨을 때의 효과와 데이터 준비도를 무료로 진단하고, 맞는 첫 단계를 확인하세요.">
  <section class="py-[clamp(56px,9vw,96px)]">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-start">
      <div class="lg:sticky lg:top-24">
        <SectionHead as="h1" label="무료 시스템화 진단" title="우리 회사 업무, 시스템으로 바꾸면 얼마나 달라질까요?">
          엑셀로 버티는 이유는 회사마다 다릅니다. 시스템이 필요할 만큼 일이 많지 않을 수도, 데이터가 흩어져 손대기 어려울 수도 있습니다.
          <strong>12개 문항으로 두 가지를 함께 진단</strong>하고, 우리 회사에 맞는 첫 단계를 알려 드립니다.
        </SectionHead>
        <p class="mt-6 text-[13px] text-ink-3">응답은 결과 계산에만 쓰이며, 리포트를 요청하지 않으면 어디에도 저장되지 않습니다.</p>
      </div>
      <Diagnosis client:load />
      <noscript><p class="text-ink-2">진단 도구를 사용하려면 브라우저에서 JavaScript를 켜 주세요.</p></noscript>
    </div>
  </section>
</Base>
