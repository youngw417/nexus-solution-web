---
// 회사 소개서 — A4 인쇄용 페이지. `npm run brochure`로 public/nexus-solution-brochure.pdf를 만듭니다.
// 문구는 사이트와 같은 src/data/content.ts에서 가져오므로, 내용을 고칠 때는 그 파일만 고치면 됩니다.
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { site } from "../data/site";
import { process, services, cases, industries, principles } from "../data/content";

const total = 12;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{site.name} 회사 소개서</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gothic+A1:wght@500;700;800&family=Noto+Sans+KR:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:global>
  @page { size: A4; margin: 0; }
  html, body { background: #D9D9D9; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { counter-reset: pg; }
  .page { counter-increment: pg;
    position: relative; box-sizing: border-box; overflow: hidden;
    width: 210mm; height: 297mm; margin: 10mm auto; padding: 20mm 18mm 24mm;
    background: #FFFFFF; display: flex; flex-direction: column;
    font-size: 10.5pt; line-height: 1.7;
  }
  .page-foot {
    position: absolute; left: 18mm; right: 18mm; bottom: 10mm;
    display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 3mm;
    font-family: var(--font-mono); font-size: 7.5pt; color: var(--ink-3); letter-spacing: .08em;
  }
  .pg::before { content: counter(pg, decimal-leading-zero) " / "; }
  .b-label { display: flex; align-items: center; margin-bottom: 4mm; font-family: var(--font-mono); font-size: 8pt; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-ink); }
  .b-h { font-family: var(--font-display); font-weight: 800; letter-spacing: -.03em; line-height: 1.3; font-size: 21pt; margin: 0 0 4mm; }
  .b-lede { color: var(--ink-2); font-size: 11pt; margin: 0 0 8mm; max-width: 150mm; }
  .b-k { font-family: var(--font-mono); font-size: 7.5pt; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 1.5mm; }
  .b-chip { display: inline-block; border: 1px solid var(--line-2); padding: .3mm 2mm; font-size: 8.5pt; margin: 0 1.2mm 1.2mm 0; }
  @media print {
    html, body { background: #FFFFFF; }
    .page { margin: 0; break-after: page; }
    .page:last-child { break-after: auto; }
  }
</style>
</head>
<body>

<!-- 1 표지 -->
<section class="page !p-0">
  <div class="flex flex-1 flex-col p-[22mm_20mm_14mm]">
    <Logo class="block h-[11mm] w-auto self-start text-ink" />
    <div class="mt-auto">
      <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>회사 소개서 · {year}</p>
      <h1 class="m-0 mb-5 font-display text-[32pt] leading-[1.22] font-extrabold tracking-[-.04em]">회사에 꼭 맞는<br>소프트웨어를 만듭니다</h1>
      <p class="m-0 max-w-[130mm] text-[11.5pt] text-ink-2">{site.sub}</p>
      <p class="mt-2 font-mono text-[9pt] text-ink-3">{site.english}</p>
    </div>
    <div class="mt-10 grid grid-cols-3 gap-6 border-t-2 border-accent pt-4 text-[9.5pt]">
      <div><p class="b-k">전화</p><p class="m-0 font-display font-bold">{site.phone}</p></div>
      <div><p class="b-k">이메일</p><p class="m-0 font-display font-bold">{site.email}</p></div>
      <div><p class="b-k">웹사이트</p><p class="m-0 font-display font-bold">nexus-ai-sol.com</p></div>
    </div>
  </div>
  <img src="/illustrations/hero-flow.svg" alt="" class="block h-[105mm] w-full flex-none object-cover" />
</section>

<!-- 2 문제 -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>이런 고민을 해결합니다</p>
  <h2 class="b-h">패키지는 업무와 맞지 않고,<br>엑셀은 한계에 왔을 때</h2>
  <p class="b-lede">직원 수십 명 규모의 회사 대부분이 주문, 재고, 고객, 현장 기록을 여전히 엑셀과 메신저로 관리합니다. 큰 회사용 패키지는 비싸고 업무 방식과 맞지 않아, 도입해도 결국 엑셀로 돌아갑니다.</p>
  <div class="grid-rule grid-cols-2">
    {[
      ["데이터가 흩어져 있습니다", "같은 업무 데이터가 여러 엑셀 파일과 개인 PC에 나뉘어 있고, 어느 파일이 최신인지 매번 묻습니다."],
      ["같은 내용을 여러 번 입력합니다", "주문서, 재고표, 보고서에 같은 숫자를 옮겨 적다 보면 실수가 생기고 월말마다 숫자가 맞지 않습니다."],
      ["현장 기록이 사라집니다", "종이 양식과 메신저 사진으로 남긴 기록은 나중에 찾기 어렵고, 증빙 자료로 쓰기에도 부족합니다."],
      ["패키지는 맞지 않습니다", "업무를 프로그램에 맞춰야 하고, 필요한 기능은 없고 쓰지 않는 기능에 비용을 냅니다."],
    ].map(([t, b]) => (
      <div class="p-6"><p class="mb-2 font-display text-[12.5pt] font-bold">{t}</p><p class="m-0 text-ink-2">{b}</p></div>
    ))}
  </div>
  <div class="mt-8 border-l-4 border-accent bg-accent-soft p-6">
    <p class="b-k !text-accent-ink">Nexus의 답</p>
    <p class="m-0 font-display text-[13.5pt] leading-snug font-bold">흩어진 데이터를 클라우드 하나로 모으고,<br>그 회사 업무에 꼭 맞는 소프트웨어를 만들어 운영까지 맡습니다.</p>
  </div>
  <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
</section>

<!-- 3 방식 · 비교 -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Nexus의 방식</p>
  <h2 class="b-h">회사를 패키지에 맞추지 않고,<br>소프트웨어를 회사에 맞춥니다</h2>
  <p class="b-lede">데이터를 정리하고, 맞춤으로 만들고, 만든 뒤에도 운영합니다. 세 가지가 한 팀 안에 있어야 업무가 실제로 바뀝니다.</p>
  <img src="/illustrations/process-diagram.svg" alt="" class="block h-auto w-full border border-line" />
  <p class="b-k mt-10">다른 선택지와 비교</p>
  <table class="w-full border-collapse text-[9.5pt]">
    <thead>
      <tr class="bg-surface-2 text-left font-mono text-[7.5pt] tracking-[.1em] text-ink-3 uppercase">
        <th class="border border-line px-3 py-2 font-medium"></th>
        <th class="border border-line px-3 py-2 font-medium">패키지 ERP</th>
        <th class="border border-line px-3 py-2 font-medium">외주 개발사</th>
        <th class="border border-line bg-accent-soft px-3 py-2 font-medium text-accent-ink">Nexus Solution</th>
      </tr>
    </thead>
    <tbody>
      {[
        ["업무와의 맞춤", "업무를 프로그램에 맞춤", "요구사항대로 개발", "업무를 먼저 진단하고 맞춰 설계"],
        ["무엇을 만들지", "정해진 기능", "고객이 정해야 함", "진단으로 함께 정함"],
        ["데이터 정리", "직접 옮겨야 함", "범위 밖인 경우가 많음", "기존 엑셀 데이터 이전 포함"],
        ["만든 뒤", "업데이트는 제품 일정대로", "납품하면 끝", "운영 · 개선을 계속 맡음"],
        ["기존 도구", "교체 전제", "별도 협의", "좋은 도구는 연결해서 활용"],
      ].map(([k, a, b, c]) => (
        <tr class="align-top">
          <td class="border border-line px-3 py-2.5 font-display font-bold">{k}</td>
          <td class="border border-line px-3 py-2.5 text-ink-2">{a}</td>
          <td class="border border-line px-3 py-2.5 text-ink-2">{b}</td>
          <td class="border border-line px-3 py-2.5 font-medium">{c}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
</section>

<!-- 4–5 서비스 -->
{[services.slice(0, 3), services.slice(3)].map((group, gi) => (
  <section class="page">
    <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>서비스 {gi === 0 ? "1 / 2" : "2 / 2"}</p>
    {gi === 0
      ? <h2 class="b-h">진단으로 시작해, 만들고, 운영합니다</h2>
      : <h2 class="b-h">필요한 것만 더합니다</h2>}
    <p class="b-lede !mb-6">{gi === 0
      ? "작게 시작해 효과를 확인하고 넓힙니다. 모든 단계에 결재 문서에 첨부할 결과물이 남습니다."
      : "이미 쓰는 도구는 살리고, 데이터가 정리된 다음에는 AI로 한 단계 더 나아갑니다."}</p>
    <div class="grid gap-4">
      {group.map((s, i) => (
        <article class="border border-line border-t-2 border-t-accent px-5 py-4">
          <div class="mb-1.5 flex items-baseline justify-between gap-4">
            <p class="m-0 font-display text-[14pt] font-extrabold tracking-[-.02em]"><span class="mr-2 font-mono text-[9pt] font-medium text-accent-ink">{String(gi * 3 + i + 1).padStart(2, "0")}</span>{s.name}</p>
            <span class="font-mono text-[7.5pt] tracking-[.12em] text-ink-3 uppercase">{s.role}</span>
          </div>
          <p class="mb-2.5 text-ink-2">{s.fit}</p>
          <div class="grid grid-cols-[1.3fr_1fr] gap-5 text-[9pt] leading-[1.6]">
            <div>
              <p class="b-k">포함 내용</p>
              <ul class="m-0 grid grid-cols-2 gap-x-4 gap-y-0.5 pl-4 list-disc marker:text-accent">{s.includes.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="grid content-start gap-1.5">
              <div><p class="b-k">진행</p><p class="m-0">{s.format.join(" · ")}</p></div>
              <div><p class="b-k">가져가는 것</p><p class="m-0 font-medium">{s.deliverables}</p></div>
            </div>
          </div>
          <p class="mt-2.5 mb-0 border-t border-line pt-2 text-[8.5pt] leading-[1.6] text-ink-3">결재 시 항목명 · <span class="text-ink-2">{s.budget}</span>{s.note && <span class="block text-accent-ink">{s.note}</span>}</p>
        </article>
      ))}
    </div>
    {gi === 1 && (
      <div class="mt-auto bg-surface-2 p-5 text-[9.5pt]">
        <p class="b-k">비용</p>
        <p class="m-0">범위와 규모가 회사마다 달라, 견적은 30분 상담 또는 데이터 정리 진단 후에 회사별로 드립니다.</p>
      </div>
    )}
    <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
  </section>
))}

<!-- 6 진행 단계 -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>일하는 방식</p>
  <h2 class="b-h">진단에서 운영까지, 다섯 단계</h2>
  <p class="b-lede">완성될 때까지 기다리지 않습니다. 2주마다 실제 화면을 보며 방향을 맞추고, 오픈한 뒤에도 계속 다듬습니다.</p>
  <ol class="m-0 grid list-none gap-0 p-0">
    {process.map((p) => (
      <li class="grid grid-cols-[22mm_38mm_1fr] items-baseline gap-4 border-b border-line py-4 first:border-t">
        <span class="font-mono text-[9pt] text-accent-ink">{p.n} · {p.en}</span>
        <span class="font-display text-[13pt] font-bold">{p.title}</span>
        <span class="text-ink-2">{p.body}</span>
      </li>
    ))}
  </ol>
  <div class="mt-10 border border-line p-6">
    <p class="b-k">구축 일정 예시 · 6주</p>
    <div class="mt-3 grid gap-3 text-[9.5pt]">
      {[
        ["1–2주", "데이터 이전 · 기본 화면", "ml-0"],
        ["3–4주", "업무 흐름 · 승인 · 권한", "ml-[33.33%]"],
        ["5–6주", "보고서 · 교육 · 오픈", "ml-[66.66%]"],
      ].map(([d, t, ml]) => (
        <div>
          <div class="mb-1 flex justify-between"><span class="font-mono text-ink-3">{d}</span><span class="text-ink-2">{t} → 시연</span></div>
          <div class="h-2 bg-surface-2"><div class={`h-full w-1/3 bg-accent ${ml}`}></div></div>
        </div>
      ))}
    </div>
    <p class="mt-4 mb-0 text-[9pt] text-ink-3">실제 일정은 진단 결과에 따라 회사별로 정합니다.</p>
  </div>
  <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
</section>

<!-- 7–9 사례: 한 쪽에 하나씩 -->
{cases.map((c, i) => (
  <section class="page">
    <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>사례 {String(i + 1).padStart(2, "0")} — {c.label}</p>
    <h2 class="b-h !text-[18pt]">{c.title}</h2>
    <p class="b-lede !mb-5 !text-[10.5pt]">{c.summary}</p>
    <img src={c.image} alt="" class="mb-1.5 block h-[104mm] w-full border border-line object-cover" />
    <p class="mb-5 text-[8pt] text-ink-3">예시 화면입니다. 실제 화면은 회사 업무에 맞춰 설계합니다.</p>
    <div class="grid grid-cols-2 gap-px border border-line bg-line text-[9.5pt]">
      <div class="bg-surface-2 p-4"><p class="b-k">이전</p><ol class="m-0 grid gap-0.5 pl-4 text-ink-2">{c.before.map((x) => <li>{x}</li>)}</ol></div>
      <div class="bg-surface p-4"><p class="b-k !text-accent-ink">이후</p><ol class="m-0 grid gap-0.5 pl-4 marker:text-accent">{c.after.map((x) => <li>{x}</li>)}</ol></div>
    </div>
    <div class="mt-4 flex flex-wrap items-center">{c.features.map((f) => <span class="b-chip">{f}</span>)}</div>
    <p class="m-0 text-[9pt] text-ink-3">이런 업무에도 맞습니다 · <span class="text-ink-2">{c.fitsFor}</span></p>
    <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
  </section>
))}

<!-- 10 업종 · 만드는 것들 -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>업종별 적용</p>
  <h2 class="b-h">이런 회사들과 일합니다</h2>
  <div class="grid-rule grid-cols-2">
    {industries.map((d) => (
      <div class="p-4">
        <p class="b-k">{d.en}</p>
        <p class="mb-1 font-display text-[12pt] font-bold">{d.name}</p>
        <p class="mb-2 text-[9pt] text-ink-2">{d.summary}</p>
        <p class="m-0 text-[8.5pt]">{d.examples.join(" · ")}</p>
      </div>
    ))}
  </div>
  <p class="b-label mt-9"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>서비스별 결과물 예시</p>
  <div class="grid grid-cols-3 gap-3">
    {services.map((s) => (
      <figure class="m-0">
        <img src={s.image} alt="" class="block aspect-[4/3] w-full border border-line object-cover" />
        <figcaption class="mt-1 font-display text-[9pt] font-bold">{s.name}</figcaption>
      </figure>
    ))}
  </div>
  <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
</section>

<!-- 11 원칙 · 자주 묻는 질문 -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>원칙</p>
  <h2 class="b-h">이렇게 일합니다</h2>
  <ol class="m-0 mb-10 grid list-none grid-cols-2 gap-px border border-line bg-line p-0">
    {principles.map((p, i) => (
      <li class="bg-surface p-5">
        <span class="font-mono text-[9pt] text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
        <p class="mt-1 mb-1.5 font-display text-[12.5pt] font-bold">{p.title}</p>
        <p class="m-0 text-[9.5pt] text-ink-2">{p.body}</p>
      </li>
    ))}
  </ol>
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>자주 받는 질문</p>
  <dl class="m-0 grid gap-5">
    {[
      ["패키지 소프트웨어와 무엇이 다른가요?", "패키지는 회사가 프로그램에 맞춰야 합니다. 맞춤 소프트웨어는 지금의 업무 흐름과 양식을 살려 만들기 때문에 직원이 새로 배울 것이 적습니다. 좋은 패키지가 이미 있으면 그것을 맞춰 쓰도록 권해 드립니다."],
      ["IT 담당자가 없어도 되나요?", "됩니다. 진단과 설계는 현업 담당자와 함께하고, 개발 · 호스팅 · 유지보수는 저희가 맡습니다."],
      ["우리 데이터는 안전한가요?", "모든 데이터는 고객사 소유이며 언제든 내려받을 수 있습니다. 접근 권한과 정기 백업을 기본으로 설계하고, AI 기능을 쓸 때는 사내 사용 기준을 먼저 정합니다."],
      ["진단만 받아도 되나요?", "물론입니다. 진단 결과물만으로도 시스템화 계획과 견적 비교 자료로 쓰실 수 있습니다. 이후 구축을 맡기시면 진단 비용을 차감합니다."],
    ].map(([q, a]) => (
      <div class="border-l-2 border-accent pl-4"><dt class="mb-1 font-display text-[11pt] font-bold">{q}</dt><dd class="m-0 text-[9.5pt] text-ink-2">{a}</dd></div>
    ))}
  </dl>
  <div class="page-foot"><span>{site.name} · 회사 소개서</span><span class="pg">{total}</span></div>
</section>

<!-- 12 연락처 -->
<section class="page !p-0">
  <div class="flex h-full flex-col on-dark bg-[#5E5653] p-[22mm_20mm] text-[#F4F4F4]">
    <p class="b-label !text-[#C9D2E1]"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>상담 안내</p>
    <h2 class="b-h !text-[26pt] !text-[#F4F4F4]">지금 쓰는 엑셀 몇 개만<br>보여 주세요</h2>
    <p class="m-0 max-w-[140mm] text-[11.5pt] opacity-80">무엇을 만들어야 할지 정해지지 않았어도 괜찮습니다. 30분 무료 상담으로 어디서부터 시스템으로 바꿀지 함께 찾습니다.</p>
    <ol class="mt-10 grid list-none gap-3 p-0 text-[10.5pt]">
      {["문의를 남기시면 영업일 1일 안에 연락드립니다.", "30분 상담(온라인 또는 방문)으로 현재 업무와 데이터를 봅니다.", "회사에 맞는 진행 방식과 견적을 정리해 보내 드립니다."].map((t, i) => (
        <li class="flex gap-4"><b class="font-mono text-[#C9D2E1]">{i + 1}</b><span class="opacity-90">{t}</span></li>
      ))}
    </ol>
    <dl class="mt-auto grid grid-cols-2 gap-x-10 gap-y-6 border-t-2 border-[#C9D2E1] pt-7 text-[10pt]">
      <div><dt class="b-k !text-[#D9D3D0]">전화</dt><dd class="m-0 font-display text-[16pt] font-bold">{site.phone}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">이메일</dt><dd class="m-0 font-display text-[16pt] font-bold">{site.email}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">웹사이트</dt><dd class="m-0">{site.url.replace("https://", "")}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">주소</dt><dd class="m-0">{site.address} ({site.postcode})</dd></div>
    </dl>
    <div class="mt-10 flex items-end justify-between">
      <img src="/logo/nexus-logo-horizontal-white.svg" alt="Nexus Solution" class="h-[9mm] w-auto" />
      <p class="m-0 text-right font-mono text-[8pt] opacity-60">{site.name} · 대표 {site.ceo}{site.bizRegNo && ` · 사업자등록번호 ${site.bizRegNo}`}<br>&copy; {year} {site.name}</p>
    </div>
  </div>
</section>

</body>
</html>
