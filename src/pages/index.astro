---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
import { process, services, departments } from "../data/content";
---
<Base>
  <!-- 01 히어로 -->
  <section class="relative overflow-hidden border-b border-line">
    <Mark class="pointer-events-none absolute -bottom-[18%] -left-[6%] w-[min(70vw,640px)] text-[var(--mark-wash)]" />
    <div class="wrap relative py-[clamp(64px,11vw,128px)]">
      <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>판교 · 기업 AI 전환 파트너</p>
      <h1 class="h1 mb-6 max-w-[17em]">기업과 AI를 연결하여<br class="max-sm:hidden"> 더 나은 비즈니스의 미래를 만듭니다</h1>
      <p class="lede mb-9 max-w-[56ch]">
        AI를 가르치지 않습니다. <strong class="font-medium text-ink">당신의 업무를 AI로 다시 설계합니다.</strong>{" "}
        실제 업무를 먼저 이해하고, AI가 가장 큰 차이를 만드는 지점을 찾아, 직원이 바로 쓸 수 있는 방식으로 바꿉니다.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/diagnosis" class="btn btn-primary">무료 AI 진단 받기</a>
        <a href="/contact" class="btn btn-ghost">상담 문의</a>
      </div>
    </div>
  </section>

  <!-- 02 문제 제기 -->
  <section class="border-b border-line py-20">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1fr] md:items-start">
      <SectionHead label="질문을 바꿉니다" title="“AI를 쓸 수 있나?”가 아니라<br>“어디에 써야 가장 효과가 큰가?”" />
      <div class="grid-rule">
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">흔한 시작</p>
          <p class="m-0 text-ink-2">전 직원 대상 ChatGPT 사용법 강의 → 몇 주 뒤 아무도 안 씀</p>
        </div>
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">막히는 지점</p>
          <p class="m-0 text-ink-2">“사내 자료를 AI에 넣어도 되나?” 아무도 답하지 못한 채 보류</p>
        </div>
        <div class="!bg-red-soft p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">Nexus의 방식</p>
          <p class="m-0 font-medium text-ink">업무 하나를 골라 실제로 바꾸고, 효과를 확인한 뒤 넓힙니다. 사용 기준도 함께 만듭니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 진단 배너 -->
  <section class="border-b border-line bg-surface">
    <div class="wrap grid gap-8 py-14 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>무료 · 3분 · 이메일 없이 시작</p>
        <h2 class="h2 mb-3">우리 회사의 AI 준비도는 몇 점일까요?</h2>
        <p class="m-0 text-ink-2">12개 문항으로 <strong class="font-medium text-ink">AI 기회의 크기</strong>와 <strong class="font-medium text-ink">도입 준비 상태</strong>를 함께 봅니다. 결과는 화면에서 바로 확인하고, 원하시면 부서별 상세 리포트를 메일로 받으실 수 있습니다.</p>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-ground p-6">
        <div class="flex items-baseline justify-between font-mono text-[12px] text-ink-3"><span>AI 기회</span><span>예시</span></div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[74%] bg-red"></div></div>
        <div class="font-mono text-[12px] text-ink-3">도입 준비도</div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[41%] bg-ink"></div></div>
        <a href="/diagnosis" class="btn btn-primary mt-3">진단 시작하기</a>
      </div>
    </div>
  </section>

  <!-- 04 5단계 프로세스 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="일하는 방식" title="이해에서 구현까지, 다섯 단계">교육으로 끝나지 않고, 실제로 업무가 바뀌는 데까지 함께합니다.</SectionHead>
      <ol class="grid-rule mt-10 list-none p-0 sm:grid-cols-2 lg:grid-cols-5">
        {process.map((s) => (
          <li class="flex flex-col gap-2 p-6">
            <span class="font-mono text-[12px] text-red-ink">{s.n} · {s.en}</span>
            <h3 class="h3 m-0">{s.title}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 업무별 AI 활용 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead label="업무별 AI 활용" title="부서마다 AI가 바꾸는 일은 다릅니다" />
        <a href="/use-cases" class="mb-4 font-display font-bold text-red-ink">업무별 시나리오 보기 →</a>
      </div>
      <div class="grid-rule mt-8 sm:grid-cols-2 lg:grid-cols-4">
        {departments.map((d) => (
          <a href={`/use-cases#${d.id}`} class="group flex flex-col gap-3 p-6 no-underline hover:!bg-ground">
            <span class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{d.en}</span>
            <h3 class="h3 m-0 text-ink group-hover:text-red-ink">{d.name}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{d.summary}</p>
            <ul class="mt-auto list-none space-y-1 border-t border-line p-0 pt-3 text-[13.5px] text-ink">
              {d.tasks.slice(0, 3).map((t) => <li>· {t.task}</li>)}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 서비스 4종 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="서비스" title="워크숍에서 구축까지, 필요한 만큼만">작게 시작해 효과를 확인하고 넓힙니다. 각 단계마다 손에 쥐는 산출물이 있습니다.</SectionHead>
      <div class="grid-rule mt-10 md:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <div class="flex flex-col gap-3 p-6">
            <span class="font-mono text-[10.5px] tracking-[.12em] text-ink-3 uppercase">{s.role}</span>
            <h3 class="h3 m-0">{s.name}</h3>
            <p class="m-0 font-mono text-[14px] font-medium text-red-ink">{s.price}</p>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.fit}</p>
            <p class="mt-auto border-t border-line pt-3 text-[13px] text-ink-2"><span class="mb-1 block font-mono text-[10.5px] tracking-[.1em] text-ink-3 uppercase">가져가는 것</span>{s.deliverables}</p>
          </div>
        ))}
      </div>
      <a href="/services" class="mt-6 inline-block font-display font-bold text-red-ink">서비스 자세히 보기 →</a>
    </div>
  </section>

  <!-- 07 산출물 샘플 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="산출물 미리보기" title="실제로 받게 되는 문서입니다">말보다 결과물이 더 정확합니다. 워크숍과 컨설팅이 끝나면 아래 형태의 문서가 남습니다.</SectionHead>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>워크숍 산출물</span><span>1 / 1</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">AI 적용 우선순위 매트릭스</p>
          <div class="relative aspect-square border border-line bg-ground">
            <span class="absolute top-2 left-2 font-mono text-[10px] text-ink-3">효과 ↑</span>
            <span class="absolute right-2 bottom-2 font-mono text-[10px] text-ink-3">난이도 →</span>
            <div class="absolute inset-0 m-auto h-px w-full bg-line"></div>
            <div class="absolute inset-0 m-auto h-full w-px bg-line"></div>
            <span class="absolute top-[18%] left-[16%] bg-red px-1.5 py-0.5 text-[11px] text-white">제안서 초안</span>
            <span class="absolute top-[32%] left-[30%] bg-red px-1.5 py-0.5 text-[11px] text-white">주간 보고</span>
            <span class="absolute top-[24%] left-[58%] border border-red px-1.5 py-0.5 text-[11px] text-red-ink">계약 검토</span>
            <span class="absolute top-[64%] left-[20%] border border-line-2 bg-surface px-1.5 py-0.5 text-[11px] text-ink-2">회의록</span>
            <span class="absolute top-[70%] left-[60%] border border-line-2 bg-surface px-1.5 py-0.5 text-[11px] text-ink-2">수요 예측</span>
          </div>
          <figcaption class="mt-3 text-[13px] text-ink-2">부서별 후보 업무를 효과와 난이도로 배치해, 무엇부터 할지 정합니다.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>컨설팅 산출물</span><span>로드맵</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">90일 도입 로드맵</p>
          <div class="space-y-2.5 text-[12px]">
            {[
              ["1–30일", "사용 규정 확정 · 파일럿 업무 2개", "w-1/3", "ml-0"],
              ["31–60일", "파일럿 확대 · 효과 측정", "w-1/3", "ml-[33%]"],
              ["61–90일", "전사 적용 · 자동화 착수", "w-1/3", "ml-[66%]"],
            ].map(([d, t, w, ml]) => (
              <div>
                <div class="mb-1 flex justify-between text-ink-2"><span class="font-mono text-ink-3">{d}</span><span>{t}</span></div>
                <div class="h-2 bg-surface-2"><div class={`h-full bg-red ${w} ${ml}`}></div></div>
              </div>
            ))}
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">누가, 언제, 어떤 업무를 바꾸는지 결재 문서에 바로 붙일 수 있는 형태입니다.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>정책 산출물</span><span>제3조</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">사내 AI 사용 규정</p>
          <div class="space-y-1.5 border-l-2 border-red pl-3 text-[12.5px] leading-relaxed text-ink-2">
            <p class="m-0"><b class="font-medium text-ink">제3조 (데이터 등급별 사용 기준)</b></p>
            <p class="m-0">① <b class="font-medium text-ink">공개</b> — 외부 AI 서비스 사용 가능</p>
            <p class="m-0">② <b class="font-medium text-ink">내부</b> — 승인된 기업용 서비스만 사용</p>
            <p class="m-0">③ <b class="font-medium text-ink">기밀 · 개인정보</b> — 외부 AI 입력 금지</p>
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">직원이 “이건 넣어도 되나?”를 스스로 판단할 수 있게 만드는 기준입니다.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 08 교육에서 실행까지 -->
  <section class="border-b border-line bg-surface py-20">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1fr] md:items-center">
      <SectionHead label="교육에서 실행까지" title="우리는 교육에서 멈추지 않습니다">
        AI 교육만 하는 곳은 “이렇게 쓰시면 됩니다”에서 끝납니다. Nexus Solution은 소프트웨어 개발 역량을 바탕으로,
        <strong>효과가 확인된 업무를 실제 시스템으로 만듭니다.</strong> 사내 문서 검색, 반복 문서 자동화, 기존 시스템 연동까지 직접 구축합니다.
      </SectionHead>
      <ul class="grid-rule list-none p-0">
        {[
          ["교육 업체", "사용법 강의", "현업 적용은 각자"],
          ["IT 개발사", "요구사항대로 개발", "어떤 업무에 쓸지는 고객이 정해야"],
          ["Nexus Solution", "업무 진단 → 교육 → 구축", "한 팀이 처음부터 끝까지"],
        ].map(([who, what, gap], i) => (
          <li class={`grid grid-cols-[8.5em_1fr] gap-4 p-5 ${i === 2 ? "!bg-red-soft" : ""}`}>
            <span class={`font-display font-bold ${i === 2 ? "text-red-ink" : "text-ink"}`}>{who}</span>
            <span class="text-[14px] text-ink-2"><b class="font-medium text-ink">{what}</b><br>{gap}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 09 회사 소개서 -->
  <section class="border-b border-line py-16">
    <div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-[60ch]">
        <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>자료실</p>
        <h2 class="h2 mb-2">내부 보고에 쓰실 자료가 필요하신가요?</h2>
        <p class="m-0 text-ink-2">서비스 구성, 진행 방식, 산출물 예시를 정리한 회사 소개서를 드립니다. 결재 문서에 그대로 첨부하실 수 있습니다.</p>
      </div>
      {site.brochure
        ? <a href={site.brochure} class="btn btn-primary flex-none" download>회사 소개서 PDF 받기</a>
        : <a href="/resources" class="btn btn-primary flex-none">회사 소개서 요청하기</a>}
    </div>
  </section>

  <!-- 10 상담 CTA -->
  <section class="py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <SectionHead label="상담 문의" title="편한 방법으로 연락 주세요">어디서부터 시작해야 할지 정해지지 않았어도 괜찮습니다. 30분 상담으로 우리 회사에 맞는 출발점을 함께 찾습니다.</SectionHead>
        <dl class="mt-8 grid gap-5">
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">전화</dt><dd class="m-0"><a href={site.phoneHref} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-red-ink">{site.phone}</a></dd></div>
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">이메일</dt><dd class="m-0"><a href={`mailto:${site.email}`} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-red-ink">{site.email}</a></dd></div>
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">방문</dt><dd class="m-0 text-ink-2">{site.address} — 판교·분당 기업은 온사이트 미팅이 가능합니다.</dd></div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
