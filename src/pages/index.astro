---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
import { process, services, cases } from "../data/content";
---
<Base>
  <!-- 01 히어로 -->
  <section class="relative overflow-hidden border-b border-line">
    <Mark class="pointer-events-none absolute -bottom-[18%] -left-[6%] w-[min(70vw,640px)] text-[var(--mark-wash)]" />
    <div class="wrap relative py-[clamp(64px,11vw,128px)]">
      <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>판교 · 맞춤 소프트웨어 개발</p>
      <h1 class="h1 mb-6 max-w-[17em]">회사에 꼭 맞는<br class="max-sm:hidden"> 소프트웨어를 만듭니다</h1>
      <p class="lede mb-9 max-w-[56ch]">
        엑셀과 메신저에 흩어진 데이터를 클라우드로 모으고,
        <strong class="font-medium text-ink">그 회사 업무에 꼭 맞는 소프트웨어를 만들어 운영까지 맡습니다.</strong>{" "}
        회사를 패키지에 맞추지 않고, 소프트웨어를 회사에 맞춥니다.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/diagnosis" class="btn btn-primary">무료 시스템화 진단</a>
        <a href="/contact" class="btn btn-ghost">상담 문의</a>
      </div>
    </div>
  </section>

  <!-- 02 문제 제기 -->
  <section class="border-b border-line py-20">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1fr] md:items-start">
      <SectionHead label="이런 회사를 돕습니다" title="패키지는 업무와 맞지 않고,<br>엑셀은 한계에 왔을 때" />
      <div class="grid-rule">
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">흔한 현실</p>
          <p class="m-0 text-ink-2">같은 내용을 엑셀 여러 개에 옮겨 적고, 최신 파일이 무엇인지 메신저로 묻습니다</p>
        </div>
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">막히는 지점</p>
          <p class="m-0 text-ink-2">패키지 ERP는 비싸고 우리 업무 방식과 맞지 않아, 도입해도 결국 엑셀로 돌아갑니다</p>
        </div>
        <div class="!bg-red-soft p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">Nexus의 방식</p>
          <p class="m-0 font-medium text-ink">데이터부터 하나로 정리하고, 지금의 업무 흐름에 맞춘 소프트웨어를 만들어 운영까지 맡습니다.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 진단 배너 -->
  <section class="border-b border-line bg-surface">
    <div class="wrap grid gap-8 py-14 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>무료 · 3분 · 이메일 없이 시작</p>
        <h2 class="h2 mb-3">우리 회사 업무, 시스템으로 바꾸면 얼마나 달라질까요?</h2>
        <p class="m-0 text-ink-2">12개 문항으로 <strong class="font-medium text-ink">시스템화 효과</strong>와 <strong class="font-medium text-ink">데이터 준비도</strong>를 함께 봅니다. 결과는 화면에서 바로 확인하고, 원하시면 상세 리포트를 메일로 받으실 수 있습니다.</p>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-ground p-6">
        <div class="flex items-baseline justify-between font-mono text-[12px] text-ink-3"><span>시스템화 효과</span><span>예시</span></div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[74%] bg-red"></div></div>
        <div class="font-mono text-[12px] text-ink-3">데이터 준비도</div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[41%] bg-ink"></div></div>
        <a href="/diagnosis" class="btn btn-primary mt-3">진단 시작하기</a>
      </div>
    </div>
  </section>

  <!-- 04 5단계 프로세스 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="일하는 방식" title="진단에서 운영까지, 다섯 단계">만들고 끝나지 않습니다. 쓰면서 나오는 요청을 반영하며 계속 함께합니다.</SectionHead>
      <ol class="grid-rule mt-10 list-none p-0 sm:grid-cols-2 lg:grid-cols-5">
        {process.map((s) => (
          <li class="flex flex-col gap-2 p-6">
            <span class="font-mono text-[12px] text-red-ink">{s.n} · {s.en}</span>
            <h3 class="h3 m-0">{s.title}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 사례 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead label="사례" title="엑셀에서 시스템으로, 실제로 바꾼 일들" />
        <a href="/cases" class="mb-4 font-display font-bold text-red-ink">사례 · 업종 보기 →</a>
      </div>
      <div class="grid-rule mt-8 md:grid-cols-3">
        {cases.map((c) => (
          <a href={`/cases#${c.id}`} class="group flex flex-col gap-3 p-6 no-underline hover:!bg-ground">
            <span class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{c.label}</span>
            <h3 class="h3 m-0 text-ink group-hover:text-red-ink">{c.title}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{c.summary}</p>
            <ul class="mt-auto flex list-none flex-wrap gap-1.5 border-t border-line p-0 pt-3">
              {c.features.map((f) => <li class="border border-line-2 px-2 py-0.5 text-[12.5px] text-ink">{f}</li>)}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 서비스 5종 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="서비스" title="진단으로 시작해, 만들고, 운영합니다">작게 시작해 효과를 확인하고 넓힙니다. 각 단계마다 손에 쥐는 결과물이 있습니다.</SectionHead>
      <div class="grid-rule mt-10 sm:grid-cols-2 xl:grid-cols-5">
        {services.map((s) => (
          <a href={`/services#${s.id}`} class="group flex flex-col gap-3 p-6 no-underline hover:!bg-ground">
            <span class="font-mono text-[10.5px] tracking-[.12em] text-ink-3 uppercase">{s.role}</span>
            <h3 class="h3 m-0 text-ink group-hover:text-red-ink">{s.name}</h3>
            <p class="m-0 font-mono text-[13.5px] font-medium text-red-ink">{s.price}</p>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.fit}</p>
            <p class="mt-auto border-t border-line pt-3 text-[13px] text-ink-2"><span class="mb-1 block font-mono text-[10.5px] tracking-[.1em] text-ink-3 uppercase">가져가는 것</span>{s.deliverables}</p>
          </a>
        ))}
      </div>
      <a href="/services" class="mt-6 inline-block font-display font-bold text-red-ink">서비스 자세히 보기 →</a>
    </div>
  </section>

  <!-- 07 산출물 샘플 -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="결과물 미리보기" title="실제로 받게 되는 것들입니다">말보다 결과물이 더 정확합니다. 진단부터 운영까지, 단계마다 아래 형태의 결과물이 남습니다.</SectionHead>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>진단 결과물</span><span>DB 설계</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">흩어진 엑셀 → 하나의 데이터베이스</p>
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-[11.5px]">
            <div class="grid gap-1.5">
              {["거래처_최종.xlsx", "거래처_2025(수정).xlsx", "주문관리_김대리.xlsx", "재고현황.xlsx"].map((f) => (
                <span class="truncate border border-line-2 bg-ground px-1.5 py-1 text-ink-2">{f}</span>
              ))}
            </div>
            <span class="font-mono text-red-ink">→</span>
            <div class="grid gap-1.5">
              {[["거래처", "id · 이름 · 담당자"], ["주문", "거래처 · 품목 · 수량"], ["재고", "품목 · 창고 · 수량"]].map(([t, c]) => (
                <span class="border border-red bg-surface px-1.5 py-1"><b class="block font-medium text-ink">{t}</b><span class="text-ink-3">{c}</span></span>
              ))}
            </div>
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">중복된 파일을 정리해 하나의 데이터 구조로 설계합니다. 무엇을 먼저 만들지도 함께 정합니다.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>구축 일정</span><span>2주 단위</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">2주마다 시연하는 구축 로드맵</p>
          <div class="space-y-2.5 text-[12px]">
            {[
              ["1–2주", "데이터 이전 · 기본 화면", "w-1/3", "ml-0"],
              ["3–4주", "업무 흐름 · 승인 · 권한", "w-1/3", "ml-[33%]"],
              ["5–6주", "보고서 · 교육 · 오픈", "w-1/3", "ml-[66%]"],
            ].map(([d, t, w, ml]) => (
              <div>
                <div class="mb-1 flex justify-between text-ink-2"><span class="font-mono text-ink-3">{d}</span><span>{t}</span></div>
                <div class="h-2 bg-surface-2"><div class={`h-full bg-red ${w} ${ml}`}></div></div>
              </div>
            ))}
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">완성될 때까지 기다리지 않습니다. 2주마다 실제 화면을 보며 방향을 맞춥니다.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>운영 결과물</span><span>월간</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">월간 운영 리포트</p>
          <dl class="m-0 grid grid-cols-3 gap-2 text-center">
            {[["99.9%", "가동률"], ["4건", "개선 반영"], ["0건", "미해결 오류"]].map(([v, k]) => (
              <div class="flex flex-col-reverse border border-line bg-ground px-1 py-2.5"><dt class="font-mono text-[10.5px] text-ink-3">{k}</dt><dd class="m-0 font-display text-[18px] font-bold text-ink">{v}</dd></div>
            ))}
          </dl>
          <ul class="mt-3 mb-0 grid gap-1 border-l-2 border-red pl-3 text-[12.5px] text-ink-2 list-none">
            <li>· 출고 화면에 거래처별 단가 표시</li>
            <li>· 월말 재고 보고서 자동 발송</li>
          </ul>
          <figcaption class="mt-4 text-[13px] text-ink-2">무엇이 안정적으로 돌아갔고 무엇이 바뀌었는지, 매달 한 장으로 확인합니다. (예시 수치)</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 08 비교 -->
  <section class="border-b border-line bg-surface py-20">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1fr] md:items-center">
      <SectionHead label="왜 맞춤 소프트웨어인가" title="패키지도, 단순 외주도 아닌<br>세 번째 선택">
        패키지는 회사가 프로그램에 맞춰야 하고, 단순 외주는 만들고 나면 끝납니다. Nexus Solution은
        <strong>업무를 먼저 이해하고, 회사에 맞게 만들고, 운영까지 책임집니다.</strong> 필요하면 Odoo 같은 검증된 오픈소스와 AI도 함께 씁니다.
      </SectionHead>
      <ul class="grid-rule list-none p-0">
        {[
          ["패키지 ERP", "정해진 기능", "업무를 프로그램에 맞춰야 함"],
          ["외주 개발사", "요구사항대로 개발", "무엇을 만들지는 고객이 정하고, 운영은 각자"],
          ["Nexus Solution", "진단 → 맞춤 개발 → 운영", "한 팀이 처음부터 끝까지"],
        ].map(([who, what, gap], i) => (
          <li class={`grid grid-cols-[8.5em_1fr] gap-4 p-5 ${i === 2 ? "!bg-red-soft" : ""}`}>
            <span class={`font-display font-bold ${i === 2 ? "text-red-ink" : "text-ink"}`}>{who}</span>
            <span class="text-[14px] text-ink-2"><b class="font-medium text-ink">{what}</b><br>{gap}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 09 회사 소개서 -->
  <section class="border-b border-line py-16">
    <div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-[60ch]">
        <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>자료실</p>
        <h2 class="h2 mb-2">내부 보고에 쓰실 자료가 필요하신가요?</h2>
        <p class="m-0 text-ink-2">서비스 구성, 진행 방식, 산출물 예시를 정리한 회사 소개서를 드립니다. 결재 문서에 그대로 첨부하실 수 있습니다.</p>
      </div>
      {site.brochure
        ? <a href={site.brochure} class="btn btn-primary flex-none" download>회사 소개서 PDF 받기</a>
        : <a href="/resources" class="btn btn-primary flex-none">회사 소개서 요청하기</a>}
    </div>
  </section>

  <!-- 10 상담 CTA -->
  <section class="py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <SectionHead label="상담 문의" title="편한 방법으로 연락 주세요">무엇을 만들어야 할지 정해지지 않았어도 괜찮습니다. 지금 쓰는 엑셀 몇 개만 보여 주시면, 30분 상담으로 출발점을 함께 찾습니다.</SectionHead>
        <dl class="mt-8 grid gap-5">
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">전화</dt><dd class="m-0"><a href={site.phoneHref} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-red-ink">{site.phone}</a></dd></div>
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">이메일</dt><dd class="m-0"><a href={`mailto:${site.email}`} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-red-ink">{site.email}</a></dd></div>
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">방문</dt><dd class="m-0 text-ink-2">{site.address} — 판교·분당 기업은 온사이트 미팅이 가능합니다.</dd></div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
