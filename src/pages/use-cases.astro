---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { departments } from "../data/content";
---
<Base title="업무별 AI 활용" description="영업·운영·관리·인사 부서에서 AI가 실제로 바꾸는 업무와 적용 시나리오.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="업무별 AI 활용" title="부서마다 AI가 바꾸는 일은 다릅니다">
        AI 도입의 출발점은 도구가 아니라 업무입니다. 부서별로 시간이 가장 많이 드는 일을 골라,
        <strong>그 업무가 AI와 함께 어떻게 바뀌는지</strong> 시나리오로 정리했습니다.
      </SectionHead>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="부서 바로가기">
        {departments.map((d) => <a href={`#${d.id}`} class="border border-line-2 bg-surface px-3.5 py-1.5 text-[14px] text-ink no-underline hover:border-red hover:text-red-ink">{d.name}</a>)}
      </nav>
    </div>
  </section>

  {departments.map((d, i) => (
    <section id={d.id} class={`scroll-mt-20 border-b border-line py-16 ${i % 2 ? "bg-surface" : ""}`}>
      <div class="wrap">
        <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>{d.en}</p>
        <h2 class="h2 mb-2">{d.name}</h2>
        <p class="mb-8 max-w-[60ch] text-ink-2">{d.summary}</p>

        <div class="grid gap-10 lg:grid-cols-[1fr_1.25fr]">
          <div class="self-start overflow-x-auto border border-line bg-surface">
            <table class="w-full border-collapse text-[14px]">
              <thead>
                <tr class="bg-surface-2 text-left font-mono text-[11px] tracking-[.1em] text-ink-3 uppercase">
                  <th class="border-b border-line-2 px-4 py-2.5 font-medium">업무</th>
                  <th class="border-b border-line-2 px-4 py-2.5 font-medium">AI가 하는 일</th>
                </tr>
              </thead>
              <tbody>
                {d.tasks.map((t) => (
                  <tr class="border-b border-line last:border-0 align-top">
                    <td class="px-4 py-3 font-display font-bold whitespace-nowrap">{t.task}</td>
                    <td class="px-4 py-3 text-ink-2">{t.how}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div>
            <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">적용 시나리오</p>
            <h3 class="h3 mb-4 !text-[20px]">{d.scenario.title}</h3>
            <div class="grid-rule sm:grid-cols-2">
              <div class="!bg-surface-2 p-5">
                <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">지금</p>
                <ol class="m-0 grid gap-2 list-decimal pl-5 text-[14px] text-ink-2">{d.scenario.before.map((x) => <li>{x}</li>)}</ol>
              </div>
              <div class="p-5">
                <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">AI 적용 후</p>
                <ol class="m-0 grid gap-2 list-decimal pl-5 text-[14px] text-ink marker:text-red">{d.scenario.after.map((x) => <li>{x}</li>)}</ol>
              </div>
            </div>
            <p class="mt-4 border-l-2 border-red pl-3.5 text-[14px] text-ink-2">{d.scenario.note}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="py-10">
    <div class="wrap">
      <p class="m-0 text-[13px] text-ink-3">시나리오의 소요 시간은 일반적인 업무 흐름을 가정한 예시이며, 실제 효과는 업무 진단을 통해 회사별로 산정합니다.</p>
    </div>
  </section>

  <CtaBand title="우리 회사는 어느 부서부터 시작해야 할까요?" />
</Base>
