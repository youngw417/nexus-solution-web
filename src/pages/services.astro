---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { services, process } from "../data/content";
---
<Base title="서비스" description="AI 디스커버리 워크숍, AI 사용 정책·보안 가이드라인 수립, AI 전환 컨설팅, AI 업무 자동화 구축. 작게 시작해 효과를 확인하고 넓힙니다.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="서비스" title="필요한 만큼, 단계별로">
        한 번에 큰 프로젝트를 할 필요는 없습니다. 워크숍으로 적용할 업무를 찾고, 기준을 세우고, 효과가 확인된 업무부터 바꿉니다.
        <strong>모든 단계에는 결재 문서에 첨부할 수 있는 산출물이 남습니다.</strong>
      </SectionHead>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="서비스 바로가기">
        {services.map((s) => <a href={`#${s.id}`} class="border border-line-2 bg-surface px-3.5 py-1.5 text-[14px] text-ink no-underline hover:border-red hover:text-red-ink">{s.name}</a>)}
      </nav>
    </div>
  </section>

  {services.map((s, i) => (
    <section id={s.id} class={`scroll-mt-20 border-b border-line py-16 ${i % 2 ? "bg-surface" : ""}`}>
      <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.15fr]">
        <div>
          <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>{String(i + 1).padStart(2, "0")} — {s.role}</p>
          <h2 class="h2 mb-3">{s.name}</h2>
          <p class="mb-5 text-[17px] text-ink-2">{s.fit}</p>
          <dl class="grid gap-4 text-[14.5px]">
            <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">비용</dt><dd class="m-0 font-mono text-[17px] font-medium text-red-ink">{s.price}</dd></div>
            <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">진행</dt><dd class="m-0 text-ink">{s.format.join(" · ")}</dd></div>
            <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">결재 시 항목명</dt><dd class="m-0 text-ink">{s.budget}</dd></div>
          </dl>
        </div>
        <div class="grid-rule self-start">
          <div class="p-6">
            <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">포함 내용</p>
            <ul class="m-0 grid gap-2 list-disc pl-5 text-ink-2 marker:text-red sm:grid-cols-2">
              {s.includes.map((x) => <li>{x}</li>)}
            </ul>
          </div>
          <div class="p-6">
            <p class="mb-2 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">가져가는 것</p>
            <p class="m-0 font-medium text-ink">{s.deliverables}</p>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="border-b border-line py-16">
    <div class="wrap">
      <SectionHead label="진행 방식" title="어떤 서비스든 같은 순서로 진행합니다" />
      <ol class="grid-rule mt-8 list-none p-0 sm:grid-cols-2 lg:grid-cols-5">
        {process.map((p) => (
          <li class="p-5"><span class="font-mono text-[12px] text-red-ink">{p.n}</span><h3 class="h3 mt-1 mb-1">{p.title}</h3><p class="m-0 text-[13.5px] leading-relaxed text-ink-2">{p.body}</p></li>
        ))}
      </ol>
      <div class="mt-10 border border-line border-t-2 border-t-red bg-surface p-6">
        <p class="mb-2 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">자주 받는 질문</p>
        <dl class="m-0 grid gap-5 md:grid-cols-3">
          <div><dt class="mb-1 font-display font-bold">사내 자료가 외부로 나가지 않나요?</dt><dd class="m-0 text-[14px] text-ink-2">데이터 등급을 먼저 나누고, 기밀·개인정보는 외부 AI에 입력하지 않는 구성으로 설계합니다. 필요하면 사내 환경에서만 동작하도록 구축합니다.</dd></div>
          <div><dt class="mb-1 font-display font-bold">IT 담당자가 없어도 되나요?</dt><dd class="m-0 text-[14px] text-ink-2">됩니다. 워크숍과 컨설팅은 현업 담당자 중심으로 진행하고, 구축 단계에서 필요한 기술 작업은 저희가 맡습니다.</dd></div>
          <div><dt class="mb-1 font-display font-bold">워크숍만 진행해도 되나요?</dt><dd class="m-0 text-[14px] text-ink-2">물론입니다. 대부분의 고객사가 워크숍으로 시작해, 효과를 확인한 뒤 다음 단계를 결정합니다.</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
