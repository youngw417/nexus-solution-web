---
// English company brochure — A4 print page. `npm run brochure` builds public/nexus-solution-brochure-en.pdf from it.
// Mirrors src/pages/brochure.astro; shared wording comes from src/data/content.en.ts.
import "../../styles/global.css";
import Logo from "../../components/Logo.astro";
import { site } from "../../data/site.en";
import { process, services, cases, industries, principles } from "../../data/content.en";

const total = 12;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{site.name} Company Brochure</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/fonts/BusanDandiGothic-M.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/BusanDandiGothic-B.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap">
<style is:global>
  @page { size: A4; margin: 0; }
  html, body { background: #D9D9D9; }
  * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { counter-reset: pg; }
  .page { counter-increment: pg;
    position: relative; box-sizing: border-box; overflow: hidden;
    width: 210mm; height: 297mm; margin: 10mm auto; padding: 20mm 18mm 24mm;
    background: #FFFFFF; display: flex; flex-direction: column;
    font-size: 10.5pt; line-height: 1.7;
  }
  .page-foot {
    position: absolute; left: 18mm; right: 18mm; bottom: 10mm;
    display: flex; justify-content: space-between; border-top: 1px solid var(--line); padding-top: 3mm;
    font-family: var(--font-mono); font-size: 7.5pt; color: var(--ink-3); letter-spacing: .08em;
  }
  .pg::before { content: counter(pg, decimal-leading-zero) " / "; }
  .b-label { display: flex; align-items: center; margin-bottom: 4mm; font-family: var(--font-mono); font-size: 8pt; letter-spacing: .14em; text-transform: uppercase; color: var(--accent-ink); }
  .b-h { font-family: var(--font-display); font-weight: 800; letter-spacing: -.03em; line-height: 1.3; font-size: 21pt; margin: 0 0 4mm; }
  .b-lede { color: var(--ink-2); font-size: 11pt; margin: 0 0 8mm; max-width: 150mm; }
  .b-k { font-family: var(--font-mono); font-size: 7.5pt; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 1.5mm; }
  .b-chip { display: inline-block; border: 1px solid var(--line-2); padding: .3mm 2mm; font-size: 8.5pt; margin: 0 1.2mm 1.2mm 0; }
  @media print {
    html, body { background: #FFFFFF; }
    .page { margin: 0; break-after: page; }
    .page:last-child { break-after: auto; }
  }
</style>
</head>
<body>

<!-- 1 Cover -->
<section class="page !p-0">
  <div class="flex flex-1 flex-col p-[22mm_20mm_14mm]">
    <Logo class="block h-[11mm] w-auto self-start text-ink" />
    <div class="mt-auto">
      <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Company brochure · {year}</p>
      <h1 class="m-0 mb-5 font-display text-[32pt] leading-[1.22] font-extrabold tracking-[-.04em]">Software built<br>to fit your business</h1>
      <p class="m-0 max-w-[130mm] text-[11.5pt] text-ink-2">{site.sub}</p>
    </div>
    <div class="mt-10 grid grid-cols-3 gap-6 border-t-2 border-accent pt-4 text-[9.5pt]">
      <div><p class="b-k">Phone</p><p class="m-0 font-display font-bold">{site.phone}</p></div>
      <div><p class="b-k">Email</p><p class="m-0 font-display font-bold">{site.email}</p></div>
      <div><p class="b-k">Website</p><p class="m-0 font-display font-bold">nexus-ai-sol.com</p></div>
    </div>
  </div>
  <img src="/illustrations/en/hero-flow.svg" alt="" class="block h-[105mm] w-full flex-none object-cover" />
</section>

<!-- 2 The problem -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>The problems we solve</p>
  <h2 class="b-h">When your current software doesn't fit the work,<br>and spreadsheets have hit their limit</h2>
  <p class="b-lede">Most companies with a few dozen employees still manage orders, inventory, customers, and field records in spreadsheets and chat apps. Off-the-shelf ERP is expensive and doesn't match how they work, so even after adopting it they end up back in spreadsheets.</p>
  <div class="grid-rule grid-cols-2">
    {[
      ["Data is scattered", "The same business data is split across many spreadsheets and personal PCs, and people keep asking which file is the latest."],
      ["The same data is entered again and again", "Copying the same numbers into order sheets, inventory lists, and reports leads to mistakes, and the numbers don't match at month-end."],
      ["Field records get lost", "Records kept on paper forms and in chat photos are hard to find later and fall short as evidence."],
      ["Off-the-shelf software doesn't fit", "You have to adapt your work to the program, the features you need are missing, and you pay for ones you don't use."],
    ].map(([t, b]) => (
      <div class="p-6"><p class="mb-2 font-display text-[12.5pt] font-bold">{t}</p><p class="m-0 text-ink-2">{b}</p></div>
    ))}
  </div>
  <div class="mt-8 border-l-4 border-accent bg-accent-soft p-6">
    <p class="b-k !text-accent-ink">The Nexus answer</p>
    <p class="m-0 font-display text-[13.5pt] leading-snug font-bold">We bring your scattered data into one cloud,<br>build software that fits the way your company works, and keep it running.</p>
  </div>
  <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
</section>

<!-- 3 Approach · comparison -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>The Nexus approach</p>
  <h2 class="b-h">We don't fit your company to a package.<br>We fit the software to your company.</h2>
  <p class="b-lede">We organize the data, build to fit, and keep running it after launch. Work only really changes when all three sit in one team.</p>
  <img src="/illustrations/en/process-diagram.svg" alt="" class="block h-auto w-full border border-line" />
  <p class="b-k mt-10">Compared with the alternatives</p>
  <table class="w-full border-collapse text-[9.5pt]">
    <thead>
      <tr class="bg-surface-2 text-left font-mono text-[7.5pt] tracking-[.1em] text-ink-3 uppercase">
        <th class="border border-line px-3 py-2 font-medium"></th>
        <th class="border border-line px-3 py-2 font-medium">Off-the-shelf ERP</th>
        <th class="border border-line px-3 py-2 font-medium">Outsourced developers</th>
        <th class="border border-line bg-accent-soft px-3 py-2 font-medium text-accent-ink">Nexus Solution</th>
      </tr>
    </thead>
    <tbody>
      {[
        ["Fit with your work", "You adapt to the program", "Built to your spec", "We assess the work first, then design to fit"],
        ["What gets built", "Fixed features", "You have to decide", "Decided together through the assessment"],
        ["Data cleanup", "You migrate it yourself", "Often out of scope", "Migration of existing spreadsheet data included"],
        ["After launch", "Updates on the vendor's schedule", "Ends at delivery", "We keep running and improving it"],
        ["Existing tools", "Assumes replacement", "Negotiated separately", "Good tools are connected and kept"],
      ].map(([k, a, b, c]) => (
        <tr class="align-top">
          <td class="border border-line px-3 py-2.5 font-display font-bold">{k}</td>
          <td class="border border-line px-3 py-2.5 text-ink-2">{a}</td>
          <td class="border border-line px-3 py-2.5 text-ink-2">{b}</td>
          <td class="border border-line px-3 py-2.5 font-medium">{c}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
</section>

<!-- 4–5 Services -->
{[services.slice(0, 3), services.slice(3)].map((group, gi) => (
  <section class="page">
    <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Services {gi === 0 ? "1 / 2" : "2 / 2"}</p>
    {gi === 0
      ? <h2 class="b-h">Start with an assessment, then build and run</h2>
      : <h2 class="b-h">Add only what you need</h2>}
    <p class="b-lede !mb-4">{gi === 0
      ? "Start small, confirm it works, and expand. Every stage leaves a deliverable you can attach to an approval request."
      : "Keep the tools you already use, and once your data is in order, go a step further with AI."}</p>
    <div class="grid gap-3">
      {group.map((s, i) => (
        <article class="border border-line border-t-2 border-t-accent px-5 py-3">
          <div class="mb-1.5 flex items-baseline justify-between gap-4">
            <p class="m-0 font-display text-[14pt] font-extrabold tracking-[-.02em]"><span class="mr-2 font-mono text-[9pt] font-medium text-accent-ink">{String(gi * 3 + i + 1).padStart(2, "0")}</span>{s.name}</p>
            <span class="font-mono text-[7.5pt] tracking-[.12em] text-ink-3 uppercase">{s.role}</span>
          </div>
          <p class="mb-1.5 text-[10pt] text-ink-2">{s.fit}</p>
          <div class="grid grid-cols-[1.45fr_1fr] gap-5 text-[8.5pt] leading-[1.5]">
            <div>
              <p class="b-k">What's included</p>
              <ul class="m-0 grid grid-cols-2 gap-x-4 gap-y-0.5 pl-4 list-disc marker:text-accent">{s.includes.map((x) => <li>{x}</li>)}</ul>
            </div>
            <div class="grid content-start gap-1.5">
              <div><p class="b-k">Format</p><p class="m-0">{s.format.join(" · ")}</p></div>
              <div><p class="b-k">What you get</p><p class="m-0 font-medium">{s.deliverables}</p></div>
            </div>
          </div>
          <p class="mt-2 mb-0 border-t border-line pt-1.5 text-[8pt] leading-[1.5] text-ink-3">Budget line item · <span class="text-ink-2">{s.budget}</span>{s.note && <span class="block text-accent-ink">{s.note}</span>}</p>
        </article>
      ))}
    </div>
    {gi === 1 && (
      <div class="mt-auto bg-surface-2 p-5 text-[9.5pt]">
        <p class="b-k">Cost</p>
        <p class="m-0">Scope and scale differ for every company, so we quote per company after a 30-minute consultation or a Data Assessment.</p>
      </div>
    )}
    <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
  </section>
))}

<!-- 6 Process -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>How we work</p>
  <h2 class="b-h">Five steps, from assessment to operations</h2>
  <p class="b-lede">You don't wait until it's finished. Every two weeks we look at real screens together and adjust course, and we keep refining after launch.</p>
  <ol class="m-0 grid list-none gap-0 p-0">
    {process.map((p) => (
      <li class="grid grid-cols-[22mm_38mm_1fr] items-baseline gap-4 border-b border-line py-4 first:border-t">
        <span class="font-mono text-[9pt] text-accent-ink">{p.n}</span>
        <span class="font-display text-[13pt] font-bold">{p.title}</span>
        <span class="text-ink-2">{p.body}</span>
      </li>
    ))}
  </ol>
  <div class="mt-10 border border-line p-6">
    <p class="b-k">Sample build schedule · 6 weeks</p>
    <div class="mt-3 grid gap-3 text-[9.5pt]">
      {[
        ["Wk 1–2", "Data migration · core screens", "ml-0"],
        ["Wk 3–4", "Workflow · approvals · permissions", "ml-[33.33%]"],
        ["Wk 5–6", "Reports · training · launch", "ml-[66.66%]"],
      ].map(([d, t, ml]) => (
        <div>
          <div class="mb-1 flex justify-between"><span class="font-mono text-ink-3">{d}</span><span class="text-ink-2">{t} → demo</span></div>
          <div class="h-2 bg-surface-2"><div class={`h-full w-1/3 bg-accent ${ml}`}></div></div>
        </div>
      ))}
    </div>
    <p class="mt-4 mb-0 text-[9pt] text-ink-3">The actual schedule is set per company based on the assessment.</p>
  </div>
  <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
</section>

<!-- 7–9 Cases, one per page -->
{cases.map((c, i) => (
  <section class="page">
    <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Case {String(i + 1).padStart(2, "0")} — {c.label}</p>
    <h2 class="b-h !text-[18pt]">{c.title}</h2>
    <p class="b-lede !mb-5 !text-[10.5pt]">{c.summary}</p>
    <img src={c.image} alt="" class="mb-1.5 block h-[104mm] w-full border border-line object-cover" />
    <p class="mb-5 text-[8pt] text-ink-3">A sample screen. Real screens are designed around your company's work.</p>
    <div class="grid grid-cols-2 gap-px border border-line bg-line text-[9.5pt]">
      <div class="bg-surface-2 p-4"><p class="b-k">Before</p><ol class="m-0 grid gap-0.5 pl-4 text-ink-2">{c.before.map((x) => <li>{x}</li>)}</ol></div>
      <div class="bg-surface p-4"><p class="b-k !text-accent-ink">After</p><ol class="m-0 grid gap-0.5 pl-4 marker:text-accent">{c.after.map((x) => <li>{x}</li>)}</ol></div>
    </div>
    <div class="mt-4 flex flex-wrap items-center">{c.features.map((f) => <span class="b-chip">{f}</span>)}</div>
    <p class="m-0 text-[9pt] text-ink-3">Also a fit for · <span class="text-ink-2">{c.fitsFor}</span></p>
    <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
  </section>
))}

<!-- 10 Industries · sample deliverables -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>By industry</p>
  <h2 class="b-h">The kinds of companies we work with</h2>
  <div class="grid-rule grid-cols-2">
    {industries.map((d) => (
      <div class="p-4">
        <p class="mb-1 font-display text-[12pt] font-bold">{d.name}</p>
        <p class="mb-2 text-[9pt] text-ink-2">{d.summary}</p>
        <p class="m-0 text-[8.5pt]">{d.examples.join(" · ")}</p>
      </div>
    ))}
  </div>
  <p class="b-label mt-9"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Sample deliverables by service</p>
  <div class="grid grid-cols-3 gap-3">
    {services.map((s) => (
      <figure class="m-0">
        <img src={s.image} alt="" class="block aspect-[4/3] w-full border border-line object-cover" />
        <figcaption class="mt-1 font-display text-[9pt] font-bold">{s.name}</figcaption>
      </figure>
    ))}
  </div>
  <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
</section>

<!-- 11 Principles · FAQ -->
<section class="page">
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Principles</p>
  <h2 class="b-h">How we work</h2>
  <ol class="m-0 mb-10 grid list-none grid-cols-2 gap-px border border-line bg-line p-0">
    {principles.map((p, i) => (
      <li class="bg-surface p-5">
        <span class="font-mono text-[9pt] text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
        <p class="mt-1 mb-1.5 font-display text-[12.5pt] font-bold">{p.title}</p>
        <p class="m-0 text-[9.5pt] text-ink-2">{p.body}</p>
      </li>
    ))}
  </ol>
  <p class="b-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Frequently asked</p>
  <dl class="m-0 grid gap-5">
    {[
      ["How is this different from off-the-shelf software?", "With off-the-shelf software, the company has to adapt to the program. Custom software keeps your current workflow and forms, so your team has little new to learn. If a good package already exists, we'll recommend fitting that to your company instead."],
      ["What if we don't have an IT person?", "That's fine. We do the assessment and design with the people who do the work, and we handle development, hosting, and maintenance."],
      ["Is our data safe?", "All data belongs to you and can be downloaded at any time. Access control and regular backups are part of the design from the start, and before any AI feature is used we set internal usage guidelines first."],
      ["Can we do just the assessment?", "Of course. The assessment deliverables alone work as a systemization plan and as a basis for comparing quotes. If you later have us build, the assessment fee is deducted."],
    ].map(([q, a]) => (
      <div class="border-l-2 border-accent pl-4"><dt class="mb-1 font-display text-[11pt] font-bold">{q}</dt><dd class="m-0 text-[9.5pt] text-ink-2">{a}</dd></div>
    ))}
  </dl>
  <div class="page-foot"><span>{site.name} · Company brochure</span><span class="pg">{total}</span></div>
</section>

<!-- 12 Contact -->
<section class="page !p-0">
  <div class="flex h-full flex-col on-dark bg-[#5E5653] p-[22mm_20mm] text-[#F4F4F4]">
    <p class="b-label !text-[#C9D2E1]"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Get in touch</p>
    <h2 class="b-h !text-[26pt] !text-[#F4F4F4]">Just show us a few of the<br>spreadsheets you use today</h2>
    <p class="m-0 max-w-[140mm] text-[11.5pt] opacity-80">It's fine if you haven't decided what to build. In a free 30-minute consultation we'll work out together where to start.</p>
    <ol class="mt-10 grid list-none gap-3 p-0 text-[10.5pt]">
      {["Send us a message and we'll reply within three business days.", "We look at your current work and data in a 30-minute consultation, online or in person.", "We send you a proposed approach and a quote that fit your company."].map((t, i) => (
        <li class="flex gap-4"><b class="font-mono text-[#C9D2E1]">{i + 1}</b><span class="opacity-90">{t}</span></li>
      ))}
    </ol>
    <dl class="mt-auto grid grid-cols-2 gap-x-10 gap-y-6 border-t-2 border-[#C9D2E1] pt-7 text-[10pt]">
      <div><dt class="b-k !text-[#D9D3D0]">Phone</dt><dd class="m-0 font-display text-[16pt] font-bold">{site.phone}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">Email</dt><dd class="m-0 font-display text-[16pt] font-bold">{site.email}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">Website</dt><dd class="m-0">{site.url.replace("https://", "")}</dd></div>
      <div><dt class="b-k !text-[#D9D3D0]">Address</dt><dd class="m-0">{site.address} ({site.postcode})</dd></div>
    </dl>
    <div class="mt-10 flex items-end justify-between">
      <img src="/logo/nexus-logo-horizontal-white.svg" alt="Nexus Solution" class="h-[9mm] w-auto" />
      <p class="m-0 text-right font-mono text-[8pt] opacity-60">{site.name} · CEO {site.ceo}{site.bizRegNo && ` · Business registration no. ${site.bizRegNo}`}<br>&copy; {year} {site.name}</p>
    </div>
  </div>
</section>

</body>
</html>
