---
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import CtaBand from "../../components/CtaBand.astro";
import { site } from "../../data/site.en";
import { capabilities, principles } from "../../data/content.en";
---
<Base title="About" description="Nexus Solution organizes a company's scattered data, builds software that fits that company, and keeps it running.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="About" title="Software that fits your company,<br>one team from start to finish">
        Instead of making a company adapt to packaged software, {site.name} builds <strong>software that adapts to the company</strong>.
        We organize scattered data, develop systems around the workflow ourselves, and stay on to run and improve them after launch.
      </SectionHead>
    </div>
  </section>

  <section class="border-b border-line">
    <img src="/photos/about-work.jpg" width="2000" height="857" class="block aspect-[21/9] max-h-[460px] w-full object-cover object-[center_20%]"
         alt="Two people in hard hats and safety vests looking over a factory floor with a tablet and a laptop" />
  </section>

  <section class="border-b border-line py-16">
    <div class="wrap">
      <SectionHead label="Three capabilities" title="Building alone doesn't change how work gets done" />
      <img src="/illustrations/en/process-diagram.svg" width="1000" height="340" loading="lazy" class="mt-8 block h-auto w-full border border-line"
           alt="A flow from data cleanup to custom build to run and improve, looping from operations back to development for continuous improvement" />
      <div class="grid-rule mt-8 md:grid-cols-3">
        {capabilities.map(({ name: k, body }) => (
          <div class="p-6">
            <h3 class="h3 mt-1 mb-2 !text-[20px]">{k}</h3>
            <p class="m-0 text-[14.5px] text-ink-2">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-surface py-16">
    <div class="wrap grid gap-10 md:grid-cols-2">
      <SectionHead label="Principles" title="How we work" />
      <ol class="m-0 grid list-none gap-6 p-0">
        {principles.map(({ title: t, body: b }, i) => (
          <li class="grid grid-cols-[2.5em_1fr] gap-3">
            <span class="font-mono text-[13px] text-accent-ink">{String(i + 1).padStart(2, "0")}</span>
            <span><b class="mb-1 block font-display text-[16.5px]">{t}</b><span class="text-[14.5px] text-ink-2">{b}</span></span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16">
    <div class="wrap">
      <SectionHead label="Company information" title="Nexus Solution" />
      <dl class="grid-rule mt-6 sm:grid-cols-2">
        {[
          ["Company", site.name],
          ["CEO", site.ceo],
          ["Address", `${site.address} (${site.postcode})`],
          ["Contact", `${site.phone} · ${site.email}`],
          ...(site.bizRegNo ? [["Business registration no.", site.bizRegNo]] : []),
        ].map(([k, v]) => (
          <div class="p-5"><dt class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{k}</dt><dd class="m-0 text-ink">{v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <CtaBand />
</Base>
