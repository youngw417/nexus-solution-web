---
// English home page — mirrors src/pages/index.astro. Keep the two in step when the layout changes.
import Base from "../../layouts/Base.astro";
import SectionHead from "../../components/SectionHead.astro";
import ContactForm from "../../components/ContactForm.astro";
import { site } from "../../data/site.en";
import { process, services, cases } from "../../data/content.en";
---
<Base>
  <!-- 01 Hero -->
  <section class="on-dark relative isolate flex min-h-[clamp(520px,78vh,760px)] items-end overflow-hidden border-b border-line bg-band text-[#EFEDEB]">
    <img src="/photos/home-hero.jpg" width="2400" height="1028" alt="" fetchpriority="high"
         class="absolute inset-0 -z-20 h-full w-full object-cover object-center">
    <div aria-hidden="true" class="absolute inset-0 -z-10"
         style="background: linear-gradient(to top, rgba(30,27,26,.92) 0%, rgba(30,27,26,.62) 45%, rgba(30,27,26,.28) 100%), linear-gradient(to right, rgba(30,27,26,.55) 0%, rgba(30,27,26,0) 65%);"></div>
    <div class="wrap w-full pt-[clamp(120px,18vw,200px)] pb-[clamp(48px,7vw,80px)]">
      <p class="eyebrow !text-[#C9D2E1]"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Custom software development</p>
      <div class="grid gap-8 lg:grid-cols-[1.25fr_1fr] lg:items-end">
        <h1 class="h1 m-0 max-w-[17em] !text-[#F4F4F4]">Software built<br class="max-sm:hidden"> to fit your business</h1>
        <div>
          <p class="mb-7 text-[clamp(15.5px,2vw,17px)] leading-[1.8] text-[#D9D3D0]">
            We bring your scattered data into a cloud database,{" "}
            <strong class="font-medium text-[#F4F4F4]">build software that fits the way your company works, and keep it running.</strong>
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="/en/diagnosis" class="btn btn-primary">Free readiness check</a>
            <a href="/en/contact" class="btn border-[#F4F4F4]/40 text-[#F4F4F4] hover:border-[#C9D2E1] hover:text-[#C9D2E1]">Contact us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 02 The problem -->
  <section class="border-b border-line py-20">
    <div class="wrap grid gap-12 md:grid-cols-[1fr_1fr] md:items-start">
      <div>
        <SectionHead label="Who we help" title="When your current software doesn't fit the work,<br>and spreadsheets have hit their limit" />
        <img src="/photos/home-work.jpg" width="2400" height="1000" loading="lazy" class="mt-6 block aspect-[16/10] w-full border border-line object-cover object-[55%_center]"
             alt="Several people reviewing a tablet and printed reports together at a table" />
      </div>
      <div class="grid-rule">
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">The usual reality</p>
          <p class="m-0 text-ink-2">The same information gets copied into several spreadsheets, and it takes time to find out which file is the latest</p>
        </div>
        <div class="p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">Where it gets stuck</p>
          <p class="m-0 text-ink-2">Off-the-shelf ERP is expensive and doesn't match how we work, so even after adopting it we end up back in spreadsheets</p>
        </div>
        <div class="!bg-accent-soft p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-accent-ink uppercase">The Nexus approach</p>
          <p class="m-0 font-medium text-ink">We start by bringing your data together in one place, then build software around your current workflow and keep it running.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 Readiness check banner -->
  <section class="border-b border-line bg-surface">
    <div class="wrap grid gap-8 py-14 md:grid-cols-[1.4fr_1fr] md:items-center">
      <div>
        <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Free · 3 minutes · no email to start</p>
        <h2 class="h2 mb-3">How much would change if your work ran on a system?</h2>
        <p class="m-0 text-ink-2">Twelve questions measure your <strong class="font-medium text-ink">system impact</strong> and <strong class="font-medium text-ink">data readiness</strong> together. You see the results on screen right away, and can get a detailed report by email if you'd like.</p>
      </div>
      <div class="flex flex-col gap-3 border border-line bg-ground p-6">
        <div class="flex items-baseline justify-between font-mono text-[12px] text-ink-3"><span>System impact</span><span>Sample</span></div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[74%] bg-accent"></div></div>
        <div class="font-mono text-[12px] text-ink-3">Data readiness</div>
        <div class="h-2.5 bg-surface-2"><div class="h-full w-[41%] bg-ink"></div></div>
        <a href="/en/diagnosis" class="btn btn-primary mt-3">Start the check</a>
      </div>
    </div>
  </section>

  <!-- 04 Five-step process -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="How we work" title="Five steps, from assessment to operations">We don't build and walk away. We stay with you, building in the requests that come up as you use it.</SectionHead>
      <ol class="grid-rule mt-10 list-none p-0 sm:grid-cols-2 lg:grid-cols-5">
        {process.map((s) => (
          <li class="flex flex-col gap-2 p-6">
            <span class="font-mono text-[12px] text-accent-ink">{s.n}</span>
            <h3 class="h3 m-0">{s.title}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 05 Cases -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <SectionHead label="Cases" title="From spreadsheets to systems: work we've changed" />
        <a href="/en/cases" class="mb-4 font-display font-bold text-accent-ink">See cases and industries →</a>
      </div>
      <div class="grid-rule mt-8 md:grid-cols-3">
        {cases.map((c) => (
          <a href={`/en/cases#${c.id}`} class="group flex flex-col gap-3 p-0 no-underline hover:!bg-ground">
            <img src={c.image} width="800" height="640" alt="" loading="lazy" class="block aspect-[5/4] w-full border-b border-line object-cover" />
            <div class="flex flex-1 flex-col gap-3 px-6 pb-6">
            <span class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{c.label}</span>
            <h3 class="h3 m-0 text-ink group-hover:text-accent-ink">{c.title}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{c.summary}</p>
            <ul class="mt-auto flex list-none flex-wrap gap-1.5 border-t border-line p-0 pt-3">
              {c.features.map((f) => <li class="border border-line-2 px-2 py-0.5 text-[12.5px] text-ink">{f}</li>)}
            </ul>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 06 Five services -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="Services" title="Start with an assessment, then build and run">Start small, confirm it works, and expand. Every stage leaves you with something concrete in hand.</SectionHead>
      <div class="grid-rule mt-10 sm:grid-cols-2 xl:grid-cols-5">
        {services.map((s) => (
          <a href={`/en/services#${s.id}`} class="group flex flex-col gap-3 p-0 no-underline hover:!bg-ground">
            <img src={s.image} width="480" height="360" alt="" loading="lazy" class="block aspect-[4/3] w-full border-b border-line object-cover" />
            <div class="flex flex-1 flex-col gap-3 px-6 pb-6">
            <span class="font-mono text-[10.5px] tracking-[.12em] text-ink-3 uppercase">{s.role}</span>
            <h3 class="h3 m-0 text-ink group-hover:text-accent-ink">{s.name}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{s.fit}</p>
            <p class="mt-auto border-t border-line pt-3 text-[13px] text-ink-2"><span class="mb-1 block font-mono text-[10.5px] tracking-[.1em] text-ink-3 uppercase">What you get</span>{s.deliverables}</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/en/services" class="mt-6 inline-block font-display font-bold text-accent-ink">See services in detail →</a>
    </div>
  </section>

  <!-- 07 Sample deliverables -->
  <section class="border-b border-line py-20">
    <div class="wrap">
      <SectionHead label="Deliverables preview" title="What you actually receive">Deliverables say more than words. From assessment to operations, each stage leaves you with something like the examples below.</SectionHead>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>Assessment</span><span>DB design</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">Scattered spreadsheets → one database</p>
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3 text-[11.5px]">
            <div class="grid gap-1.5">
              {["customers_final.xlsx", "customers_2025(edit).xlsx", "orders_jkim.xlsx", "inventory.xlsx"].map((f) => (
                <span class="truncate border border-line-2 bg-ground px-1.5 py-1 text-ink-2">{f}</span>
              ))}
            </div>
            <span class="font-mono text-accent-ink">→</span>
            <div class="grid gap-1.5">
              {[["Customers", "id · name · contact"], ["Orders", "customer · item · qty"], ["Inventory", "item · warehouse · qty"]].map(([t, c]) => (
                <span class="border border-accent bg-surface px-1.5 py-1"><b class="block font-medium text-ink">{t}</b><span class="text-ink-3">{c}</span></span>
              ))}
            </div>
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">We clean up duplicate files and design a single data structure, and decide together what to build first.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>Build schedule</span><span>2-week cycles</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">A build roadmap with a demo every two weeks</p>
          <div class="space-y-2.5 text-[12px]">
            {[
              ["Wk 1–2", "Data migration · core screens", "w-1/3", "ml-0"],
              ["Wk 3–4", "Workflow · approvals · permissions", "w-1/3", "ml-[33%]"],
              ["Wk 5–6", "Reports · training · launch", "w-1/3", "ml-[66%]"],
            ].map(([d, t, w, ml]) => (
              <div>
                <div class="mb-1 flex justify-between text-ink-2"><span class="font-mono text-ink-3">{d}</span><span>{t}</span></div>
                <div class="h-2 bg-surface-2"><div class={`h-full bg-accent ${w} ${ml}`}></div></div>
              </div>
            ))}
          </div>
          <figcaption class="mt-4 text-[13px] text-ink-2">You don't wait until it's finished. Every two weeks we look at real screens together and adjust course.</figcaption>
        </figure>
        <figure class="m-0 border border-line bg-surface p-5">
          <div class="mb-3 flex items-center justify-between font-mono text-[10.5px] text-ink-3"><span>Operations</span><span>Monthly</span></div>
          <p class="mb-3 font-display text-[15px] font-bold">Monthly operations report</p>
          <dl class="m-0 grid grid-cols-3 gap-2 text-center">
            {[["99.9%", "Uptime"], ["4", "Improvements"], ["0", "Open issues"]].map(([v, k]) => (
              <div class="flex flex-col-reverse border border-line bg-ground px-1 py-2.5"><dt class="font-mono text-[10.5px] text-ink-3">{k}</dt><dd class="m-0 font-display text-[18px] font-bold text-ink">{v}</dd></div>
            ))}
          </dl>
          <ul class="mt-3 mb-0 grid gap-1 border-l-2 border-accent pl-3 text-[12.5px] text-ink-2 list-none">
            <li>· Customer-specific pricing shown on the shipping screen</li>
            <li>· Month-end inventory report sent automatically</li>
          </ul>
          <figcaption class="mt-4 text-[13px] text-ink-2">One page each month shows what ran smoothly and what changed. (Sample figures)</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- 08 Comparison -->
  <section class="border-b border-line bg-surface py-20">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1fr] md:items-center">
      <SectionHead label="Why custom software" title="Not off-the-shelf, not plain outsourcing:<br>a third option">
        With off-the-shelf software, the company has to adapt to the program. With plain outsourcing, it's over once the build is done. Nexus Solution
        <strong>understands the work first, builds to fit the company, and takes responsibility for operations.</strong> Where it helps, we also use proven open source such as Odoo, and AI.
      </SectionHead>
      <ul class="grid-rule list-none p-0">
        {[
          ["Off-the-shelf ERP", "Fixed features", "You adapt your work to the program"],
          ["Outsourced developers", "Built to your spec", "You decide what to build, and operations are on you"],
          ["Nexus Solution", "Assess → custom build → operate", "One team from start to finish"],
        ].map(([who, what, gap], i) => (
          <li class={`grid grid-cols-[8.5em_1fr] gap-4 p-5 ${i === 2 ? "!bg-accent-soft" : ""}`}>
            <span class={`font-display font-bold ${i === 2 ? "text-accent-ink" : "text-ink"}`}>{who}</span>
            <span class="text-[14px] text-ink-2"><b class="font-medium text-ink">{what}</b><br>{gap}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 09 Brochure -->
  <section class="border-b border-line py-16">
    <div class="wrap flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="max-w-[60ch]">
        <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>Resources</p>
        <h2 class="h2 mb-2">Need something to share internally?</h2>
        <p class="m-0 text-ink-2">Our company brochure covers our services, how we work, and sample deliverables. You can attach it to an internal approval request as is.</p>
      </div>
      {site.brochure
        ? <a href={site.brochure} class="btn btn-primary flex-none" download>Download brochure (PDF)</a>
        : <a href="/en/resources" class="btn btn-primary flex-none">Request the brochure</a>}
    </div>
  </section>

  <!-- 10 Contact -->
  <section class="py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <SectionHead label="Contact" title="Reach us whichever way is easiest">It's fine if you haven't decided what to build. Show us a few of the spreadsheets you use today, and in a 30-minute call we'll find a starting point together.</SectionHead>
        <dl class="mt-8 grid gap-5">
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">Phone</dt><dd class="m-0"><a href={site.phoneHref} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-accent-ink">{site.phone}</a></dd></div>
          <div><dt class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">Email</dt><dd class="m-0"><a href={`mailto:${site.email}`} class="font-display text-[22px] font-bold tracking-[-.02em] text-ink no-underline hover:text-accent-ink">{site.email}</a></dd></div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
