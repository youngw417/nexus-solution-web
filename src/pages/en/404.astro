---
import Base from "../../layouts/Base.astro";
---
<Base title="Page not found">
  <section class="py-[clamp(72px,14vw,160px)]">
    <div class="wrap max-w-[720px]">
      <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>404</p>
      <h1 class="h1 mb-4">Page not found</h1>
      <p class="lede mb-8">The address has changed or the page doesn't exist.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/en" class="btn btn-primary">Home</a>
        <a href="/en/contact" class="btn btn-ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>
