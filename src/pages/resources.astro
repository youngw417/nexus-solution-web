---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import ContactForm from "../components/ContactForm.astro";
import { site } from "../data/site";
---
<Base title="자료실" description="Nexus Solution 회사 소개서와 AI 도입 검토 자료. 내부 보고와 결재 문서에 첨부하실 수 있습니다.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="자료실" title="내부 보고에 필요한 자료를 드립니다">
        AI 도입을 검토하실 때 팀장님, 임원께 보고할 자료가 필요하시죠. 서비스 구성과 진행 방식, 산출물 예시를 정리한 자료를 <strong>결재 문서에 그대로 첨부</strong>하실 수 있도록 준비했습니다.
      </SectionHead>
    </div>
  </section>

  <section class="border-b border-line py-16">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1.2fr]">
      <div>
        <div class="border border-line border-t-2 border-t-red bg-surface p-6">
          <p class="mb-1 font-mono text-[11px] tracking-[.12em] text-red-ink uppercase">PDF</p>
          <h2 class="h3 mb-2 !text-[21px]">Nexus Solution 회사 소개서</h2>
          <ul class="mb-5 grid gap-1.5 list-disc pl-5 text-[14.5px] text-ink-2 marker:text-red">
            <li>회사 소개와 일하는 방식</li>
            <li>서비스 4종 구성과 진행 기간</li>
            <li>단계별 산출물 예시</li>
            <li>업무별 AI 적용 시나리오</li>
          </ul>
          {site.brochure
            ? <a href={site.brochure} class="btn btn-primary" download>PDF 내려받기</a>
            : <p class="m-0 text-[14px] text-ink-2">오른쪽 양식으로 요청하시면 <strong class="font-medium text-ink">메일로 보내 드립니다.</strong></p>}
        </div>

        <h2 class="h3 mt-10 mb-3">함께 보시면 좋은 자료</h2>
        <ul class="grid-rule list-none p-0">
          <li><a href="/diagnosis" class="block p-5 no-underline hover:!bg-ground"><b class="block font-display text-ink">AI 준비도 진단 결과 리포트</b><span class="text-[14px] text-ink-2">3분 진단 후 부서별 상세 리포트를 받아 보고 자료로 쓰실 수 있습니다.</span></a></li>
          <li><a href="/use-cases" class="block p-5 no-underline hover:!bg-ground"><b class="block font-display text-ink">업무별 AI 적용 시나리오</b><span class="text-[14px] text-ink-2">영업·운영·관리·인사 부서별 적용 예시.</span></a></li>
          <li><a href="/services" class="block p-5 no-underline hover:!bg-ground"><b class="block font-display text-ink">서비스 구성과 비용</b><span class="text-[14px] text-ink-2">결재 시 항목명과 산출물까지 정리했습니다.</span></a></li>
        </ul>
      </div>

      {!site.brochure && (
        <div>
          <h2 class="h3 mb-4">소개서 요청</h2>
          <ContactForm kind="brochure" submitLabel="소개서 받기" messageLabel="추가로 필요한 자료 (선택)" messagePlaceholder="예: 견적서 양식, 커리큘럼 예시가 필요합니다" />
        </div>
      )}
    </div>
  </section>
</Base>
