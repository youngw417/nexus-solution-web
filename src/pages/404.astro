---
import Base from "../layouts/Base.astro";
---
<Base title="페이지를 찾을 수 없습니다">
  <section class="py-[clamp(72px,14vw,160px)]">
    <div class="wrap max-w-[720px]">
      <p class="eyebrow"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>404</p>
      <h1 class="h1 mb-4">페이지를 찾을 수 없습니다</h1>
      <p class="lede mb-8">주소가 바뀌었거나 없는 페이지입니다.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">홈으로</a>
        <a href="/contact" class="btn btn-ghost">상담 문의</a>
      </div>
    </div>
  </section>
</Base>
