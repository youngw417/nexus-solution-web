---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import CtaBand from "../components/CtaBand.astro";
import { cases, industries } from "../data/content";
---
<Base title="사례 · 업종" description="현장 양식 디지털화, 현장 사진 증빙, 오픈소스 ERP 맞춤 도입 사례와 제조 · 교육기관 · 유통 · 전문 서비스 업종별 적용 예시.">
  <section class="border-b border-line py-[clamp(56px,9vw,96px)]">
    <div class="wrap">
      <SectionHead as="h1" label="사례 · 업종" title="엑셀에서 시스템으로,<br>실제로 바꾼 일들">
        고객사의 업종과 이름은 밝히지 않고, <strong>무엇이 어떻게 바뀌었는지</strong>를 기능 중심으로 소개합니다.
        같은 방식은 업종이 달라도 그대로 적용됩니다.
      </SectionHead>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="사례 바로가기">
        {cases.map((c) => <a href={`#${c.id}`} class="border border-line-2 bg-surface px-3.5 py-1.5 text-[14px] text-ink no-underline hover:border-accent hover:text-accent-ink">{c.label}</a>)}
        <a href="#industries" class="border border-line-2 bg-surface px-3.5 py-1.5 text-[14px] text-ink no-underline hover:border-accent hover:text-accent-ink">업종별 적용</a>
      </nav>
    </div>
  </section>

  {cases.map((c, i) => (
    <section id={c.id} class={`scroll-mt-20 border-b border-line py-16 ${i % 2 ? "bg-surface" : ""}`}>
      <div class="wrap">
        <div class="mb-10 grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-center">
          <div>
            <p class="sec-label"><span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>사례 {String(i + 1).padStart(2, "0")} — {c.label}</p>
            <h2 class="h2 mb-3">{c.title}</h2>
            <p class="m-0 max-w-[60ch] text-ink-2">{c.summary}</p>
          </div>
          <figure class="m-0">
            <img src={c.image} width="800" height="640" alt={`${c.label} 예시 화면`} loading={i === 0 ? "eager" : "lazy"} class="block h-auto w-full border border-line" />
            <figcaption class="mt-2 text-[12.5px] text-ink-3">예시 화면입니다. 실제 화면은 회사 업무에 맞춰 설계합니다.</figcaption>
          </figure>
        </div>

        <div class="grid gap-10 lg:grid-cols-[1.25fr_1fr]">
          <div class="grid-rule self-start sm:grid-cols-2">
            <div class="!bg-surface-2 p-5">
              <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">이전</p>
              <ol class="m-0 grid gap-2 list-decimal pl-5 text-[14px] text-ink-2">{c.before.map((x) => <li>{x}</li>)}</ol>
            </div>
            <div class="p-5">
              <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-accent-ink uppercase">이후</p>
              <ol class="m-0 grid gap-2 list-decimal pl-5 text-[14px] text-ink marker:text-accent">{c.after.map((x) => <li>{x}</li>)}</ol>
            </div>
          </div>

          <div class="grid-rule self-start">
            <div class="p-5">
              <p class="mb-3 font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">주요 기능</p>
              <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                {c.features.map((f) => <li class="border border-line-2 px-2.5 py-1 text-[13.5px] text-ink">{f}</li>)}
              </ul>
            </div>
            <div class="p-5">
              <p class="mb-2 font-mono text-[11px] tracking-[.12em] text-accent-ink uppercase">이런 업무에도 맞습니다</p>
              <p class="m-0 text-[14.5px] text-ink">{c.fitsFor}</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section id="industries" class="scroll-mt-20 border-b border-line py-16">
    <div class="wrap">
      <SectionHead label="업종별 적용" title="이런 회사들과 일합니다">
        업종마다 엑셀에 쌓이는 데이터는 다르지만, 정리하고 시스템으로 만드는 방법은 같습니다.
      </SectionHead>
      <div class="grid-rule mt-8 sm:grid-cols-2 lg:grid-cols-4">
        {industries.map((d) => (
          <div class="flex flex-col gap-3 p-6">
            <span class="font-mono text-[11px] tracking-[.12em] text-ink-3 uppercase">{d.en}</span>
            <h3 class="h3 m-0">{d.name}</h3>
            <p class="m-0 text-[14px] leading-relaxed text-ink-2">{d.summary}</p>
            <ul class="mt-auto list-none space-y-1 border-t border-line p-0 pt-3 text-[13.5px] text-ink">
              {d.examples.map((t) => <li>· {t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="우리 회사 엑셀, 어디서부터 시스템으로 바꿀까요?" />
</Base>
