{
  "trailingSlash": "never",
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/use-cases", "redirect": "/cases", "statusCode": 301 },
    { "route": "/_astro/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/og.png", "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/favicon.svg", "headers": { "cache-control": "public, max-age=86400" } },
    { "route": "/apple-touch-icon.png", "headers": { "cache-control": "public, max-age=86400" } }
  ],
  "platform": { "apiRuntime": "node:22" }
}
